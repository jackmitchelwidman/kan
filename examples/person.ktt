-- A type `Person` that DEPENDS ON A VALUE (a name).
-- Run:  kan check examples/person.ktt
--
-- Note 1: Kan has no built-in String yet, so we use a small `Name` type as a
--         stand-in for the name. Real string names would work exactly the same
--         way once strings are added.
-- Note 2: types-that-depend-on-values live in Kan's typed language (.ktt).

-- our stand-in for names (imagine these are the strings "alice", "bob"):
data Name { alice : Name, bob : Name }

-- `Person` is a TYPE INDEXED BY A NAME: for each name n, `Person n` is the type
-- of the data we keep about the person called n. Here every person's data is an
-- age (a Nat), so `Person` is a family of types, one for each name value.
def Person : Name -> U
           = \n. Nat

-- inhabitants: the data for specific, named people.
-- `alice_data : Person alice` — its TYPE mentions the value `alice`.
def alice_data : Person alice = 30
def bob_data   : Person bob   = 42

-- a DEPENDENT FUNCTION over names: the result type `Person n` depends on the
-- argument value `n`. (Every new person starts at age 0.)
def new_person : (n : Name) -> Person n
              = \n. 0
