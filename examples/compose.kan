-- Composition emerges from filling an inner horn. There is no `compose`.
-- Two composable maps form a horn; its filler's new edge is the composite.

set A = 3
set B = 2
set C = 4

map f : A -> B = [0, 1, 1]
map g : B -> C = [3, 2]

let gf = fill inner (f, g)   -- the (2,1)-horn's missing edge = g∘f

show gf                      -- expect  A -> C : [3; 2; 2]
