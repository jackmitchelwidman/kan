-- A recursive datatype and folds over it.
-- List A is the initial algebra of F(X) = 1 + A·X.

data List { Nil, Cons int List }

let xs = Cons(3, Cons(1, Cons(4, Cons(1, Cons(5, Nil)))))
show xs

-- each fold is the unique homomorphism out of the initial algebra (a universal fill):
fold sum    : List -> int { Nil = 0, Cons p rest = p + rest }
fold length : List -> int { Nil = 0, Cons p rest = 1 + rest }

show sum(xs)       -- 14
show length(xs)    -- 5
