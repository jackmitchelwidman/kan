-- ============================================================================
-- examples/creal.kan — constructive reals in action (std/creal.kan).
--
-- A real is a process producing rational approximations to any precision. Here we
-- read several off to ten decimal places with `scaledFloor x d = ⌊x · 10^d⌋`, and
-- do exact arithmetic on them. Each `eval` prints the digits; the regression gate
-- also checks that `kan run`, the OCaml backend, and the C backend all agree.
-- ============================================================================
import "../std/creal.kan"

-- √2, π, e to ten decimal places:
eval scaledFloor sqrt2 10                       -- 14142135623   (√2 = 1.4142135623…)
eval scaledFloor piC   10                       -- 31415926535   (π  = 3.1415926535…)
eval scaledFloor eC    10                       -- 27182818284   (e  = 2.7182818284…)

-- arithmetic on reals, read back to ten / six places:
eval scaledFloor (addC sqrt2 (fromIntC 1z)) 10  -- 24142135623   (√2 + 1)
eval scaledFloor (subC piC eC) 10               -- 4233108251    (π − e = 0.4233108251…)
eval scaledFloor (mulC sqrt2 sqrt2) 6           -- 2000000       (√2 · √2 = 2)

-- division REQUIRES an apartness-from-zero witness. √2 ≥ 1 = 1/2^0, so `apart 0`:
eval scaledFloor (recipC sqrt2 (apart 0)) 10    -- 7071067811    (1/√2 = 0.7071067811…)

-- ---- the math library (Rational -> CReal): √, exp, natural powers ----------
eval scaledFloor (sqrtQ (fromInt 5z)) 10            -- 22360679774     (√5)
eval scaledFloor (sqrtQ (fromInt 1000000z)) 10      -- 10000000000000  (√1e6 = 1000; large-arg seed test)
eval scaledFloor (expQ (fromInt 1z)) 10             -- 27182818284     (e via expQ — matches eC above)
eval scaledFloor (expQ (fromInt 2z)) 10             -- 73890560989     (e²)
eval scaledFloor (expQ (fromInt (isub 0z 1z))) 10   -- 3678794411      (e⁻¹)
eval scaledFloor (powNatC (sqrtQ (fromInt 2z)) 2) 6 -- 2000000         ((√2)² = 2)

-- (there is deliberately no `eqC : CReal -> CReal -> Bool` — equality of reals is
--  undecidable; the positive notion is the apartness witness used just above.)
