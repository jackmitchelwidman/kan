-- ============================================================================
-- examples/namespaces.kan — Kan's module system.
--
-- Two modules each declare a type `Color` AND a function `code`. They coexist
-- because every module has its own namespace; you refer to `Paint::Color`,
-- `Paint::code`, `Mood::code`, etc. — datatypes, constructors, and functions are
-- all namespaced, including inside `match`.
--
--   • import "…" as M        — qualified: use M::name
--   • import "…" exposing (…) — bring only those names in, unqualified
--   • import "…" hiding (…)   — bring everything except those
--   • private def/data        — a module-local name, invisible to importers
--   • plain import "…"         — everything a module exports, unqualified
-- Imports are explicit: you see a module's exports, never its dependencies'.
-- ============================================================================
import "ns/paint.kan" as Paint
import "ns/mood.kan"  as Mood
import "../std/nat.kan" exposing (add)     -- only `add` enters scope, unqualified

eval Paint::code Paint::blue                           -- 2
eval Mood::code  Mood::tense                           -- 20
eval Paint::code (Paint::mix Paint::red Paint::white)  -- 3   (mix red white = white)
eval Paint::mix Paint::red Paint::white                -- white   (constructor value: short name, no tag)
eval Paint::primary Paint::red                         -- true    (uses paint's PRIVATE isPrimary internally)
eval add 40 2                                          -- 42      (from `exposing (add)`)

-- Not allowed, on purpose (uncomment to see the errors):
--   eval Paint::isPrimary Paint::red   -- isPrimary is private to module paint
--   eval mul 2 3                        -- mul was not exposed from nat
