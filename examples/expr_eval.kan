-- Fold IS an interpreter. Expr is the initial algebra of a signature functor;
-- `eval` is the unique homomorphism into (int, +, *) — i.e. an evaluator.

data Expr { Lit int, Add Expr Expr, Mul Expr Expr }

let e = Mul(Add(Lit(2), Lit(3)), Lit(4))    -- (2 + 3) * 4
show e

fold eval : Expr -> int {
  Lit v   = v,
  Add a b = a + b,
  Mul a b = a * b
}

show eval(e)     -- 20
