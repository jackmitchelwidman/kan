-- A pullback is the SAME universal fill — the limit of a cospan A → C ← B.
-- The fill returns { (a,b) : f(a) = g(b) }.

set A = 3
set B = 3
set C = 2

map f : A -> C = [0, 0, 1]
map g : B -> C = [0, 1, 1]

diagram Cospan {
  vertices A, B, C
  edge 0 2 f          -- f : vertex0 (A) -> vertex2 (C)
  edge 1 2 g          -- g : vertex1 (B) -> vertex2 (C)
}

let PB = fill limit Cospan

show PB               -- 4 elements (the compatible pairs)
