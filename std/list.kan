-- std/list — polymorphic lists.
data List (A : U) { nil : List A, cons : A -> List A -> List A }

def length : (A : U) -> List A -> Nat
  = lambda A xs: match (xs : List A) { | nil => zero | cons x ys => suc (length A ys) }

def map : (A : U) -> (B : U) -> (A -> B) -> List A -> List B
  = lambda A B f xs: match (xs : List A) { | nil => nil B | cons x ys => cons B (f x) (map A B f ys) }

def append : (A : U) -> List A -> List A -> List A
  = lambda A xs ys: match (xs : List A) { | nil => ys | cons x rest => cons A x (append A rest ys) }
