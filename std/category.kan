-- std/category — category theory, in Kan.
--
-- A `Category` is a dependent record (Σ): a type of objects, a family of
-- hom-types, identities, composition, and the three laws (left/right identity,
-- associativity) carried as *proofs* (`Id`). Because the laws are fields, a
-- value of type `Category` is a category that has been *checked* to be one — the
-- type-checker is the referee. The projections are hidden behind readable
-- accessors: you write `obj C`, `hom C a b`, `idn C a`, `cmp C a b c g f`.
--
-- On top of it: `Functor` (with its two laws), `NatTrans` (natural
-- transformations), and the canonical lawful inhabitants — the terminal
-- category `One`, the identity functor, and the identity natural transformation.
-- The identity functor's laws hold by `refl`; the identity natural
-- transformation's naturality square is exactly the category's identity laws.

import "logic.kan"     -- sym, trans (equational reasoning for the proofs)
import "unit.kan"      -- Unit, for the terminal category

-- A category: objects, homs, identity, composition, and the laws.
def Category
  = (Obj : U) * (Hom : Obj -> Obj -> U)
  * (idn : (a : Obj) -> Hom a a)
  * (cmp : (a : Obj) -> (b : Obj) -> (c : Obj) -> Hom b c -> Hom a b -> Hom a c)
  * (idl : (a : Obj) -> (b : Obj) -> (f : Hom a b) -> Id (Hom a b) (cmp a a b f (idn a)) f)
  * (idr : (a : Obj) -> (b : Obj) -> (f : Hom a b) -> Id (Hom a b) (cmp a b b (idn b) f) f)
  * ((a : Obj) -> (b : Obj) -> (c : Obj) -> (d : Obj) -> (h : Hom c d) -> (g : Hom b c) -> (f : Hom a b)
       -> Id (Hom a d) (cmp a b d (cmp b c d h g) f) (cmp a c d h (cmp a b c g f)))

-- accessors (they hide the fst/snd projections)
def obj  : Category -> U = \C. fst C
def hom  : (C : Category) -> obj C -> obj C -> U = \C. fst (snd C)
def idn  : (C : Category) -> (a : obj C) -> hom C a a = \C. fst (snd (snd C))
def cmp  : (C : Category) -> (a : obj C) -> (b : obj C) -> (c : obj C) -> hom C b c -> hom C a b -> hom C a c
         = \C. fst (snd (snd (snd C)))
def idl  : (C : Category) -> (a : obj C) -> (b : obj C) -> (f : hom C a b) -> Id (hom C a b) (cmp C a a b f (idn C a)) f
         = \C. fst (snd (snd (snd (snd C))))
def idr  : (C : Category) -> (a : obj C) -> (b : obj C) -> (f : hom C a b) -> Id (hom C a b) (cmp C a b b (idn C b) f) f
         = \C. fst (snd (snd (snd (snd (snd C)))))
def assoc : (C : Category) -> (a : obj C) -> (b : obj C) -> (c : obj C) -> (d : obj C)
            -> (h : hom C c d) -> (g : hom C b c) -> (f : hom C a b)
            -> Id (hom C a d) (cmp C a b d (cmp C b c d h g) f) (cmp C a c d h (cmp C a b c g f))
          = \C. snd (snd (snd (snd (snd (snd C)))))

-- the opposite category C^op: arrows reversed. Left/right identity laws swap;
-- associativity is the original, reversed with `sym`. A category, mechanically.
def op : Category -> Category
  = \C.
    ( obj C , ( \a b. hom C b a , ( \a. idn C a , ( \a b c g f. cmp C c b a f g
      , ( \a b f. idr C b a f
        , ( \a b f. idl C b a f
          , \a b c d h g f.
              sym (hom C d a)
                  (cmp C d c a (cmp C c b a f g) h)
                  (cmp C d b a f (cmp C d c b g h))
                  (assoc C d c b a f g h) ) ) ) ) ) )

-- the terminal category 1: one object, one arrow. Everything is `unit`, and the
-- laws hold because Unit has a unique element (proved with its eliminator).
def One : Category
  = ( Unit , ( \a b. Unit , ( \a. unit , ( \a b c g f. unit
      , ( \a b f. Unit_elim (\x. Id Unit unit x) refl f
        , ( \a b f. Unit_elim (\x. Id Unit unit x) refl f
          , \a b c d h g f. refl ) ) ) ) ) )

-- A functor C -> D: an action on objects and on arrows, preserving id and ∘.
def Functor : Category -> Category -> U
  = \C D.
      (F0 : obj C -> obj D)
    * (F1 : (a : obj C) -> (b : obj C) -> hom C a b -> hom D (F0 a) (F0 b))
    * (Fid : (a : obj C) -> Id (hom D (F0 a) (F0 a)) (F1 a a (idn C a)) (idn D (F0 a)))
    * ((a : obj C) -> (b : obj C) -> (c : obj C) -> (g : hom C b c) -> (f : hom C a b)
         -> Id (hom D (F0 a) (F0 c)) (F1 a c (cmp C a b c g f))
               (cmp D (F0 a) (F0 b) (F0 c) (F1 b c g) (F1 a b f)))

def fobj : (C : Category) -> (D : Category) -> Functor C D -> obj C -> obj D = \C D F. fst F
def fhom : (C : Category) -> (D : Category) -> (F : Functor C D) -> (a : obj C) -> (b : obj C)
           -> hom C a b -> hom D (fobj C D F a) (fobj C D F b)
         = \C D F. fst (snd F)

-- the identity functor; both functor laws hold definitionally.
def idFunctor : (C : Category) -> Functor C C
  = \C. ( \a. a , ( \a b f. f , ( \a. refl , \a b c g f. refl ) ) )

-- A natural transformation F => G: a family of components with the naturality
-- square commuting for every arrow.
def NatTrans : (C : Category) -> (D : Category) -> Functor C D -> Functor C D -> U
  = \C D F G.
      (eta : (a : obj C) -> hom D (fobj C D F a) (fobj C D G a))
    * ((a : obj C) -> (b : obj C) -> (f : hom C a b)
         -> Id (hom D (fobj C D F a) (fobj C D G b))
               (cmp D (fobj C D F a) (fobj C D F b) (fobj C D G b) (eta b) (fhom C D F a b f))
               (cmp D (fobj C D F a) (fobj C D G a) (fobj C D G b) (fhom C D G a b f) (eta a)))

-- the identity natural transformation F => F. Its component at a is idn(F a);
-- the naturality square is precisely D's two identity laws, glued with trans/sym.
def idNat : (C : Category) -> (D : Category) -> (F : Functor C D) -> NatTrans C D F F
  = \C D F.
      ( \a. idn D (fobj C D F a)
      , \a b f.
          trans (hom D (fobj C D F a) (fobj C D F b))
                (cmp D (fobj C D F a) (fobj C D F b) (fobj C D F b) (idn D (fobj C D F b)) (fhom C D F a b f))
                (fhom C D F a b f)
                (cmp D (fobj C D F a) (fobj C D F a) (fobj C D F b) (fhom C D F a b f) (idn D (fobj C D F a)))
                (idr D (fobj C D F a) (fobj C D F b) (fhom C D F a b f))
                (sym (hom D (fobj C D F a) (fobj C D F b))
                     (cmp D (fobj C D F a) (fobj C D F a) (fobj C D F b) (fhom C D F a b f) (idn D (fobj C D F a)))
                     (fhom C D F a b f)
                     (idl D (fobj C D F a) (fobj C D F b) (fhom C D F a b f))) )
