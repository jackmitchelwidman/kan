-- ============================================================================
-- std/gcd — verified gcd by Euclid's algorithm (ADR-013 milestone 2, stage 5).
--   gcd(a, 0) = a ;   gcd(a, b) = gcd(b, a mod b)   for b > 0.
-- Structural-only, so it is a fuel-Euclid: recursion is on `fuel`, bounded by the
-- second argument via `Le b fuel` (each step replaces b by a mod b, which is < b,
-- so the bound shrinks). `gcd_dvd` proves the gcd divides BOTH arguments — the
-- stage-5 correctness result, built on the Euclid step `dvd_mod_fwd`.
-- ============================================================================
import "divmod.kan"

-- the fuel-decrease, factored out so gcdF and its proof use the IDENTICAL term
-- (this is what makes the correctness proof line up definitionally with gcdF):
-- a mod (suc b2) < suc b2 ≤ suc f  ⟹  a mod (suc b2) ≤ f.
def gcd_en : (f : Nat) -> (a : Nat) -> (b2 : Nat) -> Le (suc b2) (suc f)
  -> Le (modI a (suc b2) (lt_zero_suc b2)) f
  = lambda f a b2 enough:
      le_trans (modI a (suc b2) (lt_zero_suc b2)) b2 f
        (le_suc_cancel (modI a (suc b2) (lt_zero_suc b2)) b2 (divmod_rem a (suc b2) (lt_zero_suc b2)))
        (le_suc_cancel b2 f enough)

def gcdF : (fuel : Nat) -> (a : Nat) -> (b : Nat) -> Le b fuel -> Nat
  = lambda fuel: match fuel {
      | zero => lambda a b enough: a            -- b ≤ 0 ⟹ b = 0 ⟹ gcd = a
      | suc f => lambda a b: match b as bb return (Le bb (suc f) -> Nat) {
          | zero  => lambda enough: a
          | suc b2 => lambda enough:            -- gcd(a, b) = gcd(b, a mod b)
              gcdF f (suc b2) (modI a (suc b2) (lt_zero_suc b2)) (gcd_en f a b2 enough) } }

-- the wrapper: fuel = b (bounds the second argument; le_refl discharges it).
def gcdI : (a : Nat) -> (b : Nat) -> Nat = lambda a b: gcdF b a b (le_refl b)

-- computation sanity (kept tiny — reducing gcd forces modI, see divmod.kan).
def g_6_4 : Id Nat (gcdI 6 4) 2 = refl
def g_6_3 : Id Nat (gcdI 6 3) 3 = refl
def g_7_5 : Id Nat (gcdI 7 5) 1 = refl
def g_8_0 : Id Nat (gcdI 8 0) 8 = refl

-- ---- CORRECTNESS: the gcd divides both arguments ----------------------------
-- the recursive step's fold (non-recursive): from the IH for (b, a mod b) — g
-- divides b and a mod b — conclude g divides a (Euclid step) and b.
def gcd_step_dvd : (g : Nat) -> (a : Nat) -> (b2 : Nat)
  -> ((Dvd g (suc b2)) * (Dvd g (modI a (suc b2) (lt_zero_suc b2))))
  -> ((Dvd g a) * (Dvd g (suc b2)))
  = lambda g a b2 ih:
      ( dvd_mod_fwd g a (suc b2) (lt_zero_suc b2) (fst ih) (snd ih) , fst ih )

-- gcdF divides both a and b. Mirrors gcdF exactly (same fuel recursion, same
-- gcd_en), so gcdF (suc f) a (suc b2) enough reduces to the very term the IH is
-- about. The b-match carries an explicit motive so `enough` and the `gcdF …`
-- subject both refine with b.
def gcdF_dvd : (fuel : Nat) -> (a : Nat) -> (b : Nat) -> (enough : Le b fuel)
  -> (Dvd (gcdF fuel a b enough) a) * (Dvd (gcdF fuel a b enough) b)
  = lambda fuel: match fuel {
      | zero => lambda a b enough:
          ( dvd_refl a
          , transp Nat (lambda z: Dvd a z) zero b (sym Nat b zero (le_zero_eq b enough)) (dvd_zero a) )
      | suc f => lambda a b: match b as bb return
          ( (en : Le bb (suc f))
            -> (Dvd (gcdF (suc f) a bb en) a) * (Dvd (gcdF (suc f) a bb en) bb) ) {
          | zero  => lambda en: ( dvd_refl a , dvd_zero a )
          | suc b2 => lambda en:
              gcd_step_dvd
                (gcdF f (suc b2) (modI a (suc b2) (lt_zero_suc b2)) (gcd_en f a b2 en)) a b2
                (gcdF_dvd f (suc b2) (modI a (suc b2) (lt_zero_suc b2)) (gcd_en f a b2 en)) } }

def gcd_dvd : (a : Nat) -> (b : Nat) -> (Dvd (gcdI a b) a) * (Dvd (gcdI a b) b)
  = lambda a b: gcdF_dvd b a b (le_refl b)

-- ---- MAXIMALITY: every common divisor of a, b divides gcd a b ---------------
-- Mirrors gcdF's recursion (shared gcd_en), discharging the step with the OTHER
-- Euclid lemma dvd_mod_bwd (c|a ∧ c|b ⟹ c|(a mod b)). Note a, c, ca are bound
-- before the b-match (they don't depend on b); en and cb ride the explicit motive.
def gcdF_greatest : (fuel : Nat) -> (a : Nat) -> (c : Nat) -> Dvd c a
  -> (b : Nat) -> (enough : Le b fuel) -> Dvd c b -> Dvd c (gcdF fuel a b enough)
  = lambda fuel: match fuel {
      | zero => lambda a c ca b enough cb: ca          -- gcdF 0 a b _ = a
      | suc f => lambda a c ca b: match b as bb return
          ((en : Le bb (suc f)) -> Dvd c bb -> Dvd c (gcdF (suc f) a bb en)) {
          | zero  => lambda en cb: ca                  -- gcdF (suc f) a 0 _ = a
          | suc b2 => lambda en cb:                    -- gcd(a,b) = gcd(b, a mod b)
              gcdF_greatest f (suc b2) c cb
                (modI a (suc b2) (lt_zero_suc b2)) (gcd_en f a b2 en)
                (dvd_mod_bwd c a (suc b2) (lt_zero_suc b2) ca cb) } }

def gcd_greatest : (c : Nat) -> (a : Nat) -> (b : Nat) -> Dvd c a -> Dvd c b -> Dvd c (gcdI a b)
  = lambda c a b ca cb: gcdF_greatest b a c ca b (le_refl b) cb

-- ---- COPRIME AFTER DIVISION: the tower's summit ------------------------------
-- Coprime x y: the only common divisors are units (divide 1).
def Coprime : Nat -> Nat -> U = lambda x y: (d : Nat) -> Dvd d x -> Dvd d y -> Dvd d 1

-- if d·g divides g (g>0), then d divides 1.  (m·(d·g)=g ⟹ (m·d)·g = 1·g ⟹ m·d=1.)
def coprime_final : (d : Nat) -> (g : Nat) -> Lt zero g -> Dvd (mul d g) g -> Dvd d 1
  = lambda d g gpos gg:
      ( fst gg
      , mul_cancel_r (mul (fst gg) d) 1 g gpos
          (trans Nat (mul (mul (fst gg) d) g) (mul (fst gg) (mul d g)) (mul 1 g)
             (mul_assoc (fst gg) d g)
             (trans Nat (mul (fst gg) (mul d g)) g (mul 1 g)
                (snd gg)
                (sym Nat (mul 1 g) g (add_n_zero g)))) )

-- THE THEOREM: if a = ca·g and b = cb·g with g = gcd a b > 0, then ca, cb are
-- coprime. (Any common divisor d of ca,cb gives d·g | a and d·g | b, so by
-- maximality d·g | g, so d | 1.)
def coprime_cofactors : (a : Nat) -> (b : Nat) -> (ca : Nat) -> (cb : Nat)
  -> Lt zero (gcdI a b)
  -> Id Nat (mul ca (gcdI a b)) a -> Id Nat (mul cb (gcdI a b)) b
  -> Coprime ca cb
  = lambda a b ca cb gpos eqa eqb d dca dcb:
      coprime_final d (gcdI a b) gpos
        (gcd_greatest (mul d (gcdI a b)) a b
           (transp Nat (lambda z: Dvd (mul d (gcdI a b)) z) (mul ca (gcdI a b)) a eqa
              (dvd_mul_both d ca (gcdI a b) dca))
           (transp Nat (lambda z: Dvd (mul d (gcdI a b)) z) (mul cb (gcdI a b)) b eqb
              (dvd_mul_both d cb (gcdI a b) dcb)))

-- COROLLARY (the usable form): the cofactors a/g and b/g extracted from gcd_dvd
-- are coprime — i.e. reducing a fraction a/b by its gcd puts it in lowest terms.
def reduce_coprime : (a : Nat) -> (b : Nat) -> Lt zero (gcdI a b)
  -> Coprime (fst (fst (gcd_dvd a b))) (fst (snd (gcd_dvd a b)))
  = lambda a b gpos:
      coprime_cofactors a b (fst (fst (gcd_dvd a b))) (fst (snd (gcd_dvd a b))) gpos
        (snd (fst (gcd_dvd a b))) (snd (snd (gcd_dvd a b)))

-- canary: the Lt 0 (gcdI …) hypothesis IS dischargeable on literals (gcd 6 4 = 2)
-- — exactly the shape a Rational smart constructor will use to feed reduce_coprime.
-- (Applying reduce_coprime here type-checks too, but forces the full coprimality
-- reduction — kept out of the gate for cost; see divmod.kan's known-cost note.)
def gcd64_pos : Lt zero (gcdI 6 4) = lt_zero_suc 1

-- the gcd of anything with a POSITIVE number is positive (it divides that
-- number). Needed to feed reduce_coprime's Lt 0 (gcdI a b) hypothesis.
def gcd_pos : (a : Nat) -> (b : Nat) -> Lt zero b -> Lt zero (gcdI a b)
  = lambda a b bpos: dvd_pos_divisor (gcdI a b) b (snd (gcd_dvd a b)) bpos
