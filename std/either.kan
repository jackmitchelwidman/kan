-- std/either — a tagged sum: a value is a left A or a right B.
data Either (A : U) (B : U) { left : A -> Either A B, right : B -> Either A B }

def either : (A : U) -> (B : U) -> (C : U) -> (A -> C) -> (B -> C) -> Either A B -> C
           = \A B C f g e. Either_elim A B (\l. C) (\a. f a) (\b. g b) e
