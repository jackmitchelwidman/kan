-- std/nat — natural-number arithmetic, with a proof.
import "logic.kan"

-- add/mul delegate to the kernel-accelerated primitives (ADR-013): O(1) bignum
-- on closed values, while obeying the SAME recursion equations as the structural
-- definitions (add 0 n = n; add (suc k) n = suc (add k n); dual for mul) — so the
-- inductive proofs below are unchanged. The commented structural forms are the
-- specification the primitives implement.
--   add m n = match m { zero => n    | suc k => suc (add k n) }
--   mul m n = match m { zero => zero | suc k => add n (mul k n) }
def add : Nat -> Nat -> Nat = lambda m n: nadd m n
def mul : Nat -> Nat -> Nat = lambda m n: nmul m n

-- equality and ordering: recursion that shrinks BOTH arguments (accumulator-
-- style), so the second argument moves through the eliminator's motive.
def eqNat : Nat -> Nat -> Bool
  = lambda m n: match m { | zero  => match n { | zero => true  | suc k => false }
                  | suc j => match n { | zero => false | suc k => eqNat j k } }
def leq : Nat -> Nat -> Bool
  = lambda m n: match m { | zero => true | suc j => match n { | zero => false | suc k => leq j k } }

-- for all n, add n zero = n — proved by induction with `match` (the recursive
-- call is the induction hypothesis; the def checking IS the proof).
def add_n_zero : (n : Nat) -> Id Nat (add n zero) n
  = lambda n: match n { | zero  => refl
                | suc k => ap Nat Nat (lambda x: suc x) (add k zero) k (add_n_zero k) }

-- addition is associative — induction on the first argument; b and c ride along.
def add_assoc : (a : Nat) -> (b : Nat) -> (c : Nat)
             -> Id Nat (add (add a b) c) (add a (add b c))
  = lambda a b c: match a { | zero  => refl
                    | suc k => ap Nat Nat (lambda x: suc x) (add (add k b) c) (add k (add b c)) (add_assoc k b c) }

-- add m (suc n) = suc (add m n) — induction on m (n rides along).
def add_suc : (m : Nat) -> (n : Nat) -> Id Nat (add m (suc n)) (suc (add m n))
  = lambda m n: match m { | zero  => refl
                  | suc k => ap Nat Nat (lambda x: suc x) (add k (suc n)) (suc (add k n)) (add_suc k n) }

-- addition is commutative — induction on m, using add_n_zero and add_suc.
def add_comm : (m : Nat) -> (n : Nat) -> Id Nat (add m n) (add n m)
  = lambda m n: match m {
      | zero  => sym Nat (add n zero) n (add_n_zero n)
      | suc k => trans Nat (suc (add k n)) (suc (add n k)) (add n (suc k))
                   (ap Nat Nat (lambda x: suc x) (add k n) (add n k) (add_comm k n))
                   (sym Nat (add n (suc k)) (suc (add n k)) (add_suc n k)) }

-- add a (add b c) = add b (add a c)  — rearrangement from assoc + comm.
def add_swap : (a : Nat) -> (b : Nat) -> (c : Nat)
            -> Id Nat (add a (add b c)) (add b (add a c))
  = lambda a b c:
      trans Nat (add a (add b c)) (add (add a b) c) (add b (add a c))
        (sym Nat (add (add a b) c) (add a (add b c)) (add_assoc a b c))
        (trans Nat (add (add a b) c) (add (add b a) c) (add b (add a c))
           (ap Nat Nat (lambda z: add z c) (add a b) (add b a) (add_comm a b))
           (add_assoc b a c))

-- m · 0 = 0 — induction on m (add zero X = X definitionally).
def mul_n_zero : (m : Nat) -> Id Nat (mul m zero) zero
  = lambda m: match m { | zero => refl | suc k => mul_n_zero k }

-- m · (suc n) = m + m·n — the distributive step, induction on m.
def mul_suc : (m : Nat) -> (n : Nat) -> Id Nat (mul m (suc n)) (add m (mul m n))
  = lambda m n: match m {
      | zero  => refl
      | suc k => trans Nat (suc (add n (mul k (suc n))))
                           (suc (add n (add k (mul k n))))
                           (suc (add k (add n (mul k n))))
                   (ap Nat Nat (lambda z: suc (add n z)) (mul k (suc n)) (add k (mul k n)) (mul_suc k n))
                   (ap Nat Nat (lambda z: suc z) (add n (add k (mul k n))) (add k (add n (mul k n)))
                       (add_swap n k (mul k n))) }

-- multiplication is commutative — induction on m, using mul_n_zero and mul_suc.
def mul_comm : (m : Nat) -> (n : Nat) -> Id Nat (mul m n) (mul n m)
  = lambda m n: match m {
      | zero  => sym Nat (mul n zero) zero (mul_n_zero n)
      | suc k => trans Nat (add n (mul k n)) (add n (mul n k)) (mul n (suc k))
                   (ap Nat Nat (lambda z: add n z) (mul k n) (mul n k) (mul_comm k n))
                   (sym Nat (mul n (suc k)) (add n (mul n k)) (mul_suc n k)) }

-- n · 1 = n (via mul_suc, mul_n_zero, add_n_zero) — needed for divisibility (Dvd 1).
def mul_n_one : (n : Nat) -> Id Nat (mul n 1) n
  = lambda n: trans Nat (mul n 1) (add n (mul n zero)) n
      (mul_suc n zero)
      (trans Nat (add n (mul n zero)) (add n zero) n
         (ap Nat Nat (lambda z: add n z) (mul n zero) zero (mul_n_zero n))
         (add_n_zero n))

-- truncated subtraction (monus): m - n, clamped at 0. Double-structural (like eqNat).
def sub : Nat -> Nat -> Nat
  = lambda m n: match m { | zero => zero | suc k => match n { | zero => suc k | suc j => sub k j } }

-- m - 0 = m
def sub_zero : (m : Nat) -> Id Nat (sub m zero) m
  = lambda m: match m { | zero => refl | suc k => refl }

-- (n + m) - n = m  — induction on n (m rides along)
def sub_add : (n : Nat) -> (m : Nat) -> Id Nat (sub (add n m) n) m
  = lambda n m: match n { | zero => sub_zero m | suc j => sub_add j m }

-- (m + n) - n = m  — the other addend, via commutativity
def add_sub : (m : Nat) -> (n : Nat) -> Id Nat (sub (add m n) n) m
  = lambda m n: trans Nat (sub (add m n) n) (sub (add n m) n) m
      (ap Nat Nat (lambda z: sub z n) (add m n) (add n m) (add_comm m n))
      (sub_add n m)
