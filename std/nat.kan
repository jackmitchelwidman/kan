-- std/nat — natural-number arithmetic, with a proof.
import "logic.kan"

def add : Nat -> Nat -> Nat = \m n. match m { | zero => n    | suc k => suc (add k n) }
def mul : Nat -> Nat -> Nat = \m n. match m { | zero => zero | suc k => add n (mul k n) }

-- for all n, add n zero = n — proved by induction (the def checking IS the proof)
def add_n_zero : (n : Nat) -> Id Nat (add n zero) n
  = \n. natElim (\m. Id Nat (add m zero) m)
                refl
                (\k ih. ap Nat Nat (\x. suc x) (add k zero) k ih)
                n

-- addition is associative — by induction on the first argument.
def add_assoc : (a : Nat) -> (b : Nat) -> (c : Nat)
             -> Id Nat (add (add a b) c) (add a (add b c))
  = \a b c. natElim (\m. Id Nat (add (add m b) c) (add m (add b c)))
                    refl
                    (\k ih. ap Nat Nat (\x. suc x) (add (add k b) c) (add k (add b c)) ih)
                    a
