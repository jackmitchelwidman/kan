-- ============================================================================
-- std/order — order (≤, <) and divisibility (|) as Σ-WITNESSES, the foundation
-- for the verified gcd tower (ADR-013 milestone 2, Level 2, stage 1).
--
-- Encoding these as witnesses rather than Bools or inductive families is
-- deliberate: it needs neither dependent Bool elimination nor motive-refinement
-- (both current kernel gaps). A proof of `Le m n` is literally the difference
-- `n - m` packaged with the equation that adds it back; a proof of `Dvd d n` is
-- the quotient packaged with the equation that multiplies it back. The `add`/`mul`
-- lemmas in std/nat.kan are exactly what discharge these.
-- ============================================================================
import "nat.kan"

-- m ≤ n : there is a k with k + m = n
def Le : Nat -> Nat -> U = lambda m n: (k : Nat) * Id Nat (add k m) n
-- m < n : suc m ≤ n
def Lt : Nat -> Nat -> U = lambda m n: Le (suc m) n
-- d | n : there is a k with k · d = n
def Dvd : Nat -> Nat -> U = lambda d n: (k : Nat) * Id Nat (mul k d) n

-- ≤ is a preorder (reflexive, transitive), and 0 is the least element.
def le_refl : (n : Nat) -> Le n n = lambda n: (zero, refl)          -- add 0 n = n
def le_zero : (n : Nat) -> Le zero n = lambda n: (n, add_n_zero n)  -- add n 0 = n

def le_trans : (a : Nat) -> (b : Nat) -> (c : Nat) -> Le a b -> Le b c -> Le a c
  = lambda a b c p q:
      ( add (fst q) (fst p)                                          -- (k2 + k1) + a = c
      , trans Nat (add (add (fst q) (fst p)) a) (add (fst q) b) c
          (trans Nat (add (add (fst q) (fst p)) a) (add (fst q) (add (fst p) a)) (add (fst q) b)
             (add_assoc (fst q) (fst p) a)
             (ap Nat Nat (lambda z: add (fst q) z) (add (fst p) a) b (snd p)))
          (snd q) )

-- divisibility: 1 divides everything, and every n divides itself.
def dvd_one  : (n : Nat) -> Dvd 1 n = lambda n: (n, mul_n_one n)    -- n · 1 = n
def dvd_refl : (n : Nat) -> Dvd n n = lambda n: (1, add_n_zero n)   -- 1 · n = n  (mul 1 n ≡ add n 0)

-- ----------------------------------------------------------------------------
-- STAGE 3 STATUS (ADR-013 milestone 2). The reusable ≤/< toolkit below is done
-- and green. The next piece — a witness-producing comparison
--   leDec : (b a : Nat) -> Either (Le b a) (Lt a b)
-- — is BLOCKED on an elaborator gap, confirmed empirically: it must case-split
-- both b and a with a result type depending on both, which needs either (i) a
-- NESTED dependent motive (the inner match can't refine its scrutinee), or (ii)
-- MUTUAL recursion (factoring the inner match into a top-level helper makes it
-- and leDec mutually recursive, which Kan's one-def/one-eliminator, no-forward-
-- reference elaboration can't express). Both are the same missing capability:
-- an explicit dependent motive, `match e return (motive) { … }` (ADR-012's
-- flagged next step). Landing that unblocks leDec -> divmodI -> the gcd theorem
-- stack (stages 3–6), and retroactively removes the helper-def workarounds used
-- elsewhere in the tower. That elaborator feature is the next investment.
-- ----------------------------------------------------------------------------

-- monotonicity toolkit for ≤ / < (used by the decision procedure and divmod).
def le_suc_mono : (m : Nat) -> (n : Nat) -> Le m n -> Le (suc m) (suc n)
  = lambda m n le:
      ( fst le
      , trans Nat (add (fst le) (suc m)) (suc (add (fst le) m)) (suc n)
          (add_suc (fst le) m)
          (ap Nat Nat (lambda z: suc z) (add (fst le) m) n (snd le)) )

def lt_zero_suc : (n : Nat) -> Lt zero (suc n)
  = lambda n: le_suc_mono zero n (le_zero n)

def le_suc_cancel : (m : Nat) -> (n : Nat) -> Le (suc m) (suc n) -> Le m n
  = lambda m n le:
      ( fst le
      , suc_inj (add (fst le) m) n
          (trans Nat (suc (add (fst le) m)) (add (fst le) (suc m)) (suc n)
             (sym Nat (add (fst le) (suc m)) (suc (add (fst le) m)) (add_suc (fst le) m))
             (snd le)) )

-- the cancellation the fuel divmod turns on:  m ≤ n  ⟹  m + (n − m) = n.
-- (From the witness add k m = n, we get n − m = k, then m + k = n.)
def le_add_sub : (m : Nat) -> (n : Nat) -> Le m n -> Id Nat (add m (sub n m)) n
  = lambda m n le:
      trans Nat (add m (sub n m)) (add m (fst le)) n
        (ap Nat Nat (lambda z: add m z) (sub n m) (fst le)
           (trans Nat (sub n m) (sub (add (fst le) m) m) (fst le)
              (ap Nat Nat (lambda z: sub z m) n (add (fst le) m)
                 (sym Nat (add (fst le) m) n (snd le)))
              (add_sub (fst le) m)))
        (trans Nat (add m (fst le)) (add (fst le) m) n
           (add_comm m (fst le))
           (snd le))
