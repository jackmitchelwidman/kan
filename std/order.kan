-- ============================================================================
-- std/order — order (≤, <) and divisibility (|) as Σ-WITNESSES, the foundation
-- for the verified gcd tower (ADR-013 milestone 2, Level 2, stage 1).
--
-- Encoding these as witnesses rather than Bools or inductive families is
-- deliberate: it needs neither dependent Bool elimination nor motive-refinement
-- (both current kernel gaps). A proof of `Le m n` is literally the difference
-- `n - m` packaged with the equation that adds it back; a proof of `Dvd d n` is
-- the quotient packaged with the equation that multiplies it back. The `add`/`mul`
-- lemmas in std/nat.kan are exactly what discharge these.
-- ============================================================================
import "nat.kan"
import "either.kan"
import "void.kan"
import "unit.kan"
import "logic.kan"

-- m ≤ n : there is a k with k + m = n
def Le : Nat -> Nat -> U = lambda m n: (k : Nat) * Id Nat (add k m) n
-- m < n : suc m ≤ n
def Lt : Nat -> Nat -> U = lambda m n: Le (suc m) n
-- d | n : there is a k with k · d = n
def Dvd : Nat -> Nat -> U = lambda d n: (k : Nat) * Id Nat (mul k d) n

-- ≤ is a preorder (reflexive, transitive), and 0 is the least element.
def le_refl : (n : Nat) -> Le n n = lambda n: (zero, refl)          -- add 0 n = n
def le_zero : (n : Nat) -> Le zero n = lambda n: (n, add_n_zero n)  -- add n 0 = n

def le_trans : (a : Nat) -> (b : Nat) -> (c : Nat) -> Le a b -> Le b c -> Le a c
  = lambda a b c p q:
      ( add (fst q) (fst p)                                          -- (k2 + k1) + a = c
      , trans Nat (add (add (fst q) (fst p)) a) (add (fst q) b) c
          (trans Nat (add (add (fst q) (fst p)) a) (add (fst q) (add (fst p) a)) (add (fst q) b)
             (add_assoc (fst q) (fst p) a)
             (ap Nat Nat (lambda z: add (fst q) z) (add (fst p) a) b (snd p)))
          (snd q) )

-- suc k is never zero — transport a type-level family (Void at 0, Unit at suc).
def suc_ne_zero : (k : Nat) -> Id Nat (suc k) zero -> Void
  = lambda k p: transp Nat (lambda n: match (eqNat n zero) { | true => Void | false => Unit }) (suc k) zero p unit

-- a ≤ 0  implies  a = 0. Case-split a with an explicit motive generalised over
-- the ≤-witness (convoy), so the suc case can refute it via suc_ne_zero.
def le_zero_eq : (a : Nat) -> Le a zero -> Id Nat a zero
  = lambda a le:
      (match a as aa return (Le aa zero -> Id Nat aa zero) {
        | zero   => lambda _: refl
        | suc a2 => lambda le2:
            absurd (Id Nat (suc a2) zero)
              (suc_ne_zero (add a2 (fst le2))
                 (trans Nat (suc (add a2 (fst le2))) (add (fst le2) (suc a2)) zero
                    (add_comm (suc a2) (fst le2))
                    (snd le2))) }) le

-- divisibility: 1 divides everything, and every n divides itself.
def dvd_one  : (n : Nat) -> Dvd 1 n = lambda n: (n, mul_n_one n)    -- n · 1 = n
def dvd_refl : (n : Nat) -> Dvd n n = lambda n: (1, add_n_zero n)   -- 1 · n = n  (mul 1 n ≡ add n 0)

-- monotonicity toolkit for ≤ / < (used by the decision procedure and divmod).
def le_suc_mono : (m : Nat) -> (n : Nat) -> Le m n -> Le (suc m) (suc n)
  = lambda m n le:
      ( fst le
      , trans Nat (add (fst le) (suc m)) (suc (add (fst le) m)) (suc n)
          (add_suc (fst le) m)
          (ap Nat Nat (lambda z: suc z) (add (fst le) m) n (snd le)) )

def lt_zero_suc : (n : Nat) -> Lt zero (suc n)
  = lambda n: le_suc_mono zero n (le_zero n)

def le_suc_cancel : (m : Nat) -> (n : Nat) -> Le (suc m) (suc n) -> Le m n
  = lambda m n le:
      ( fst le
      , suc_inj (add (fst le) m) n
          (trans Nat (suc (add (fst le) m)) (add (fst le) (suc m)) (suc n)
             (sym Nat (add (fst le) (suc m)) (suc (add (fst le) m)) (add_suc (fst le) m))
             (snd le)) )

-- the cancellation the fuel divmod turns on:  m ≤ n  ⟹  m + (n − m) = n.
-- (From the witness add k m = n, we get n − m = k, then m + k = n.)
def le_add_sub : (m : Nat) -> (n : Nat) -> Le m n -> Id Nat (add m (sub n m)) n
  = lambda m n le:
      trans Nat (add m (sub n m)) (add m (fst le)) n
        (ap Nat Nat (lambda z: add m z) (sub n m) (fst le)
           (trans Nat (sub n m) (sub (add (fst le) m) m) (fst le)
              (ap Nat Nat (lambda z: sub z m) n (add (fst le) m)
                 (sym Nat (add (fst le) m) n (snd le)))
              (add_sub (fst le) m)))
        (trans Nat (add m (fst le)) (add (fst le) m) n
           (add_comm m (fst le))
           (snd le))

-- DECISION PROCEDURE: for any b, a, either b ≤ a or a < b — WITH the witness.
-- This case-splits both arguments with a result depending on both; it is
-- possible only because of the explicit dependent motive (`match a as aa
-- return …`, ADR-015). It is the gate for divmod and the whole gcd tower.
def leDec : (b : Nat) -> (a : Nat) -> Either (Le b a) (Lt a b)
  = lambda b a: match b {
      | zero => left (Le zero a) (Lt a zero) (le_zero a)
      | suc b2 => match a as aa return (Either (Le (suc b2) aa) (Lt aa (suc b2))) {
          | zero => right (Le (suc b2) zero) (Lt zero (suc b2)) (lt_zero_suc b2)
          | suc a2 => match (leDec b2 a2 : Either (Le b2 a2) (Lt a2 b2))
                        return (Either (Le (suc b2) (suc a2)) (Lt (suc a2) (suc b2))) {
              | left le  => left  (Le (suc b2) (suc a2)) (Lt (suc a2) (suc b2)) (le_suc_mono b2 a2 le)
              | right lt => right (Le (suc b2) (suc a2)) (Lt (suc a2) (suc b2)) (le_suc_mono (suc a2) b2 lt) } } }

-- ---- the fuel-decrease for divmod: b ≤ a and 0 < b force (a - b) to shrink ----

-- 0 < b means b is a successor: b = suc (b-1).
def pos_suc : (b : Nat) -> (bp : Lt zero b) -> Id Nat b (suc (fst bp))
  = lambda b bp:
      trans Nat b (add (fst bp) (suc zero)) (suc (fst bp))
        (sym Nat (add (fst bp) (suc zero)) b (snd bp))
        (trans Nat (add (fst bp) (suc zero)) (suc (add (fst bp) zero)) (suc (fst bp))
           (add_suc (fst bp) zero)
           (ap Nat Nat (lambda z: suc z) (add (fst bp) zero) (fst bp) (add_n_zero (fst bp))))

-- 0 < b ≤ a  ⟹  a - b < a  (strict decrease), i.e. suc (a-b) ≤ a.
def sub_lt : (b : Nat) -> (a : Nat) -> (bp : Lt zero b) -> (ba : Le b a) -> Le (suc (sub a b)) a
  = lambda b a bp ba:
      ( fst bp
      , trans Nat (add (fst bp) (suc (sub a b))) (add b (sub a b)) a
          (trans Nat (add (fst bp) (suc (sub a b))) (add (suc (fst bp)) (sub a b)) (add b (sub a b))
             (add_suc (fst bp) (sub a b))
             (ap Nat Nat (lambda z: add z (sub a b)) (suc (fst bp)) b (sym Nat b (suc (fst bp)) (pos_suc b bp))))
          (le_add_sub b a ba) )

-- the fuel-sufficiency step: from a ≤ suc f (and 0 < b ≤ a), (a - b) ≤ f.
def fuel_dec : (f : Nat) -> (a : Nat) -> (b : Nat) -> Lt zero b -> Le b a -> Le a (suc f) -> Le (sub a b) f
  = lambda f a b bp ba enough:
      le_suc_cancel (sub a b) f
        (le_trans (suc (sub a b)) a (suc f) (sub_lt b a bp ba) enough)

-- ---- divisibility algebra (gcd tower, stage 4) ------------------------------
-- Everything divides 0.
def dvd_zero : (d : Nat) -> Dvd d zero = lambda d: (zero, refl)   -- mul 0 d = 0

-- d | x  and  d | y  ⟹  d | (x + y).   witness kx + ky, via right-distributivity.
def dvd_add : (d : Nat) -> (x : Nat) -> (y : Nat) -> Dvd d x -> Dvd d y -> Dvd d (add x y)
  = lambda d x y dx dy:
      ( add (fst dx) (fst dy)
      , trans Nat (mul (add (fst dx) (fst dy)) d) (add (mul (fst dx) d) (mul (fst dy) d)) (add x y)
          (mul_add_distrib_r (fst dx) (fst dy) d)
          (trans Nat (add (mul (fst dx) d) (mul (fst dy) d)) (add x (mul (fst dy) d)) (add x y)
             (ap Nat Nat (lambda z: add z (mul (fst dy) d)) (mul (fst dx) d) x (snd dx))
             (ap Nat Nat (lambda z: add x z) (mul (fst dy) d) y (snd dy))) )

-- d | b  ⟹  d | (q · b).   witness q · kb, via associativity.
def dvd_mul_l : (d : Nat) -> (q : Nat) -> (b : Nat) -> Dvd d b -> Dvd d (mul q b)
  = lambda d q b db:
      ( mul q (fst db)
      , trans Nat (mul (mul q (fst db)) d) (mul q (mul (fst db) d)) (mul q b)
          (mul_assoc q (fst db) d)
          (ap Nat Nat (lambda z: mul q z) (mul (fst db) d) b (snd db)) )

-- the forward Euclid step, on the divisor side:  d | b ⟹ d | r ⟹ d | (q·b + r).
def dvd_lin : (d : Nat) -> (q : Nat) -> (b : Nat) -> (r : Nat)
  -> Dvd d b -> Dvd d r -> Dvd d (add (mul q b) r)
  = lambda d q b r db dr: dvd_add d (mul q b) r (dvd_mul_l d q b db) dr

-- d | x  and  d | y  ⟹  d | (x - y).   witness kx - ky, via sub-distributivity.
def dvd_sub : (d : Nat) -> (x : Nat) -> (y : Nat) -> Dvd d x -> Dvd d y -> Dvd d (sub x y)
  = lambda d x y dx dy:
      ( sub (fst dx) (fst dy)
      , trans Nat (mul (sub (fst dx) (fst dy)) d) (sub (mul (fst dx) d) (mul (fst dy) d)) (sub x y)
          (mul_sub_distrib_r (fst dx) (fst dy) d)
          (trans Nat (sub (mul (fst dx) d) (mul (fst dy) d)) (sub x (mul (fst dy) d)) (sub x y)
             (ap Nat Nat (lambda z: sub z (mul (fst dy) d)) (mul (fst dx) d) x (snd dx))
             (ap Nat Nat (lambda z: sub x z) (mul (fst dy) d) y (snd dy))) )

-- ---- multiplicative cancellation (gcd tower, stage 6) -----------------------
-- (suc x)·g with g > 0 is never zero.
def mul_pos_ne_zero : (x : Nat) -> (g : Nat) -> (gpos : Lt zero g) -> Id Nat (mul (suc x) g) zero -> Void
  = lambda x g gpos p:
      suc_ne_zero (add (fst gpos) (mul x g))
        (trans Nat (suc (add (fst gpos) (mul x g))) (mul (suc x) g) zero
           (sym Nat (mul (suc x) g) (suc (add (fst gpos) (mul x g)))
              (ap Nat Nat (lambda z: add z (mul x g)) g (suc (fst gpos)) (pos_suc g gpos)))
           p)

-- RIGHT cancellation for ·:  x·g = y·g  with g > 0  ⟹  x = y.  Induction on x;
-- the mismatched-parity cases are impossible (mul_pos_ne_zero), the suc/suc case
-- cancels the leading g (add_cancel_l) then recurses.
def mul_cancel_r : (x : Nat) -> (y : Nat) -> (g : Nat) -> Lt zero g -> Id Nat (mul x g) (mul y g) -> Id Nat x y
  = lambda x: match x {
      | zero => lambda y g gpos: match y as yy return (Id Nat (mul zero g) (mul yy g) -> Id Nat zero yy) {
          | zero   => lambda p: refl
          | suc y2 => lambda p: absurd (Id Nat zero (suc y2))
                        (mul_pos_ne_zero y2 g gpos (sym Nat (mul zero g) (mul (suc y2) g) p)) }
      | suc x2 => lambda y g gpos: match y as yy return (Id Nat (mul (suc x2) g) (mul yy g) -> Id Nat (suc x2) yy) {
          | zero   => lambda p: absurd (Id Nat (suc x2) zero) (mul_pos_ne_zero x2 g gpos p)
          | suc y2 => lambda p: ap Nat Nat (lambda z: suc z) x2 y2
                        (mul_cancel_r x2 y2 g gpos (add_cancel_l g (mul x2 g) (mul y2 g) p)) } }

-- scale a divisibility by g on both sides:  d | x  ⟹  d·g | x·g.
def dvd_mul_both : (d : Nat) -> (x : Nat) -> (g : Nat) -> Dvd d x -> Dvd (mul d g) (mul x g)
  = lambda d x g dx:
      ( fst dx
      , trans Nat (mul (fst dx) (mul d g)) (mul (mul (fst dx) d) g) (mul x g)
          (sym Nat (mul (mul (fst dx) d) g) (mul (fst dx) (mul d g)) (mul_assoc (fst dx) d g))
          (ap Nat Nat (lambda z: mul z g) (mul (fst dx) d) x (snd dx)) )

-- ---- positivity of factors / divisors (for the canonical Rational) ----------
-- if x·g > 0 then x > 0 (else x=0 makes x·g = 0). Convoy on x (applied to the
-- hypothesis, so the match is not tail position — an explicit motive is allowed).
def mul_pos_factor : (x : Nat) -> (g : Nat) -> Lt zero (mul x g) -> Lt zero x
  = lambda x g h:
      (match x as xx return (Lt zero (mul xx g) -> Lt zero xx) {
        | zero  => lambda hh: hh              -- Lt 0 (mul 0 g) ≡ Lt 0 0, vacuous
        | suc k => lambda hh: lt_zero_suc k }) h

-- a divisor of a POSITIVE number is positive:  g | b, b > 0  ⟹  g > 0.
-- (If g = 0 then b = k·0 = 0, contradiction — the branch is vacuous.) Convoy on g.
def dvd_pos_divisor : (g : Nat) -> (b : Nat) -> Dvd g b -> Lt zero b -> Lt zero g
  = lambda g b dvd bpos:
      (match g as gg return (Dvd gg b -> Lt zero b -> Lt zero gg) {
        | zero  => lambda dv bp:
            transp Nat (lambda z: Lt zero z) b zero
              (trans Nat b (mul (fst dv) zero) zero
                 (sym Nat (mul (fst dv) zero) b (snd dv))
                 (mul_n_zero (fst dv)))
              bp
        | suc k => lambda dv bp: lt_zero_suc k }) dvd bpos

-- b > 0  ⟹  b + x > 0  (b is a successor, so add b x is a successor). 
def lt_zero_add_l : (b : Nat) -> (x : Nat) -> Lt zero b -> Lt zero (add b x)
  = lambda b x bpos:
      transp Nat (lambda z: Lt zero (add z x)) (suc (fst bpos)) b
        (sym Nat b (suc (fst bpos)) (pos_suc b bpos))
        (lt_zero_suc (add (fst bpos) x))

-- product of positives is positive:  a > 0, b > 0  ⟹  a·b > 0.  (For the product
-- denominator when multiplying/adding canonical rationals.) Convoy on a.
def mul_pos : (a : Nat) -> (b : Nat) -> Lt zero a -> Lt zero b -> Lt zero (mul a b)
  = lambda a b apos bpos:
      (match a as aa return (Lt zero aa -> Lt zero (mul aa b)) {
        | zero  => lambda ap: ap                                  -- vacuous (Lt 0 0)
        | suc a2 => lambda ap: lt_zero_add_l b (mul a2 b) bpos }) apos
