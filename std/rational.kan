-- ============================================================================
-- std/rational — exact rational numbers as normalized coprime pairs of Integers.
--
-- A `Rational` is  num / den  kept canonical:  den > 0  and  gcd(|num|,den) = 1,
-- restored by the internal normalizer `normQ` after every operation — so equal
-- rationals share a representation and arithmetic is exact (no floats, no
-- rounding, decidable equality). ℚ as the field of fractions of ℤ, made canonical.
--
-- SAFETY: there is no silent divide-by-zero. Reciprocal and division return
-- `Option Rational` — `none` exactly when the divisor is the zero rational — and
-- the public constructor `mkQ` returns `none` on a zero denominator. Total,
-- honest, no junk values from the public API.
--
-- Scope note (see DECISIONS.md ADR-013): den≠0 / coprimality are MAINTAINED by
-- the smart constructors here, not PROVEN in the type. The raw `rational`
-- constructor can still build a non-canonical value (e.g. `rational 3 0`); it is
-- the documented unsafe escape hatch. This is the FAST, efficient API.
--
-- The type-ENFORCED version has since LANDED: std/rational_reduced.kan carries
-- `den > 0` and coprimality as PROOF fields (divide-by-zero is a type error there,
-- and every value is provably in lowest terms) — it is the correctness-first
-- sibling. Use THIS module (`mkQ`/`fromInt`, `divQ`/`recipQ`) when you want speed
-- with a safe public API; use `rational_reduced` when you want the guarantees in
-- the type. (`eqQ`/`ltQ` cross-multiply, so they are correct even on a non-canonical input.)
--
-- Integer literals carry a `z` suffix (0z, 1z, …). Decimal-literal sugar
-- (0.25 ↦ 1/4) is a separate, deferred lexer change.
-- ============================================================================
import "option.kan"

-- --- Integer helpers (idiv / igcd / iadd / … are built-in primitives) --------
def ineg : Integer -> Integer = lambda a: isub 0z a
def imod : Integer -> Integer -> Integer = lambda a b: isub a (imul (idiv a b) b)
def iabs : Integer -> Integer = lambda a: match (ilt a 0z) { | true => ineg a | false => a }

-- --- the type: a numerator and a denominator --------------------------------
data Rational { rational : Integer -> Integer -> Rational }

def num : Rational -> Integer = lambda q: match q { | rational n d => n }
def den : Rational -> Integer = lambda q: match q { | rational n d => d }

-- --- internal normalizer: raw (n, d) with d ≠ 0 into canonical form ----------
-- (idiv by the gcd is exact — the gcd divides both — so no rounding occurs.)
-- A d = 0 input maps to the zero rational; the public entry points below never
-- pass 0 here, so callers of the public API never observe that fallback.
def normQ : Integer -> Integer -> Rational
  = lambda n d:
      match (ieq d 0z) {
      | true  => rational 0z 1z
      | false =>
          match (ilt d 0z) {
          | true  => rational (idiv (ineg n) (igcd n d)) (idiv (ineg d) (igcd n d))
          | false => rational (idiv n (igcd n d)) (idiv d (igcd n d))
          }
      }

-- --- constants and injections -----------------------------------------------
def qzero : Rational = rational 0z 1z
def qone  : Rational = rational 1z 1z
def fromInt  : Integer -> Rational = lambda n: rational n 1z          -- always safe (den 1)
def qFromNat : Nat -> Rational     = lambda n: rational (fromNat n) 1z

-- SAFE public constructor: none on a zero denominator, else the canonical value.
def mkQ : Integer -> Integer -> Option Rational
  = lambda n d: match (ieq d 0z) {
      | true  => none Rational
      | false => some Rational (normQ n d) }

-- --- field operations (total: operate on already-valid rationals) ------------
-- a/b + c/d = (a·d + c·b) / (b·d)
def addQ : Rational -> Rational -> Rational
  = lambda x y: normQ (iadd (imul (num x) (den y)) (imul (num y) (den x)))
                      (imul (den x) (den y))

def negQ : Rational -> Rational = lambda x: rational (ineg (num x)) (den x)
def subQ : Rational -> Rational -> Rational = lambda x y: addQ x (negQ y)

def mulQ : Rational -> Rational -> Rational
  = lambda x y: normQ (imul (num x) (num y)) (imul (den x) (den y))

-- --- predicates --------------------------------------------------------------
def isZeroQ : Rational -> Bool = lambda x: ieq (num x) 0z

-- --- SAFE reciprocal and division — no silent divide-by-zero -----------------
-- recip of the zero rational is `none`; otherwise d/n (renormalized for sign).
def recipQ : Rational -> Option Rational
  = lambda x: match (isZeroQ x) {
      | true  => none Rational
      | false => some Rational (normQ (den x) (num x)) }

-- x ÷ y : `none` exactly when y is zero. Impossible to divide by zero silently.
def divQ : Rational -> Rational -> Option Rational
  = lambda x y: match (recipQ y : Option Rational) {
      | none   => none Rational
      | some r => some Rational (mulQ x r) }

-- --- comparison and equality (cross-multiply; dens are positive) -------------
def eqQ : Rational -> Rational -> Bool
  = lambda x y: ieq (imul (num x) (den y)) (imul (num y) (den x))

def ltQ : Rational -> Rational -> Bool
  = lambda x y: ilt (imul (num x) (den y)) (imul (num y) (den x))

-- a ≤ b  ⟺  a < b + 1  on integers (dens are positive), so no `not` needed
def leqQ : Rational -> Rational -> Bool
  = lambda x y: ilt (imul (num x) (den y)) (iadd (imul (num y) (den x)) 1z)

-- --- more everyday operations ------------------------------------------------
def absQ  : Rational -> Rational = lambda x: rational (iabs (num x)) (den x)
def signQ : Rational -> Integer
  = lambda x: match (ieq (num x) 0z) {
      | true  => 0z
      | false => match (ilt (num x) 0z) { | true => isub 0z 1z | false => 1z } }
def minQ : Rational -> Rational -> Rational
  = lambda x y: match (leqQ x y) { | true => x | false => y }
def maxQ : Rational -> Rational -> Rational
  = lambda x y: match (leqQ x y) { | true => y | false => x }
