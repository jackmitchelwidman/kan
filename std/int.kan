-- ============================================================================
-- std/int — the INDUCTIVE integers: a verified tower under the primitive `Integer`.
--
-- Why this exists. A type-enforced `Rational` (den ≠ 0 and coprimality as PROOF
-- fields, not merely maintained by a smart constructor) needs to *prove* facts
-- about integer arithmetic and gcd. The primitive `Integer` (lib/bigint.ml) is an
-- opaque bignum with no induction principle, so nothing about `iadd`/`imul`/`idiv`
-- /`igcd` is provable. This file gives integers an inductive definition — hence
-- structural recursion and induction — exactly as Kan already does for `Nat`.
-- (Fast primitive `Integer` stays the computational layer; see ADR-013.)
--
-- Representation (unique, so Id-equality is structural):
--     pos n     =  n        (0, 1, 2, …)
--     negsuc n  =  -(n+1)    (-1, -2, -3, …)
-- ============================================================================
import "nat.kan"
import "bool.kan"
import "logic.kan"

data Int { pos : Nat -> Int, negsuc : Nat -> Int }

-- --- observers ---------------------------------------------------------------
def natAbs : Int -> Nat  = lambda i: match i { | pos m => m | negsuc n => suc n }
def isNeg  : Int -> Bool = lambda i: match i { | pos m => false | negsuc n => true }

-- structural equality on Int (unique representation, so this IS value equality).
def eqInt : Int -> Int -> Bool
  = lambda i j: match i {
      | pos m    => match j { | pos n => eqNat m n | negsuc n => false }
      | negsuc m => match j { | pos n => false     | negsuc n => eqNat m n } }

-- --- constants and injections ------------------------------------------------
def zeroI    : Int          = pos zero
def oneI     : Int          = pos (suc zero)
def fromNatI : Nat -> Int   = lambda n: pos n

-- --- negation ----------------------------------------------------------------
def negI : Int -> Int
  = lambda i: match i {
      | pos m    => match m { | zero => pos zero | suc k => negsuc k }
      | negsuc n => pos (suc n) }

-- Nat difference as an Int:  diff m n = m - n.  Structural on m (n rides along).
def diff : Nat -> Nat -> Int
  = lambda m n: match m {
      | zero  => match n { | zero => pos zero | suc k => negsuc k }
      | suc j => match n { | zero => pos (suc j) | suc k => diff j k } }

-- --- addition ----------------------------------------------------------------
def addI : Int -> Int -> Int
  = lambda i j: match i {
      | pos m    => match j { | pos n => pos (add m n)          | negsuc n => diff m (suc n) }
      | negsuc m => match j { | pos n => diff n (suc m)         | negsuc n => negsuc (add (suc m) n) } }

def subI : Int -> Int -> Int = lambda i j: addI i (negI j)

-- --- multiplication (sign · magnitude) --------------------------------------
def intOfSignMag : Bool -> Nat -> Int
  = lambda neg m: match neg {
      | false => pos m
      | true  => match m { | zero => pos zero | suc k => negsuc k } }

def mulI : Int -> Int -> Int
  = lambda i j: intOfSignMag (xor (isNeg i) (isNeg j)) (mul (natAbs i) (natAbs j))

-- --- bridge to the fast primitive Integer (computational layer) --------------
def toInteger : Int -> Integer
  = lambda i: match i { | pos m => fromNat m | negsuc n => isub 0z (fromNat (suc n)) }

-- ============================================================================
-- First proofs — the tower in action. These lean on std/nat.kan's inductive
-- lemmas, which is the whole point: facts about Int reduce to facts about Nat,
-- which ARE provable by induction. (More — commutativity, associativity, the
-- ring axioms, then verified gcd/div — build on these; see ADR-013.)
-- ============================================================================

-- natAbs of a `pos` is the identity (definitional).
def natAbs_pos : (n : Nat) -> Id Nat (natAbs (pos n)) n
  = lambda n: refl

-- natAbs recovers the magnitude of a signed-negative int:
-- natAbs (intOfSignMag true m) = m. (Case-split m — an explicit motive, ADR-015 —
-- since intOfSignMag branches on m; the Bool `true` is fixed so no Bool-elim gap.)
def natAbs_negOfMag : (m : Nat) -> Id Nat (natAbs (intOfSignMag true m)) m
  = lambda m: (match m as mm return (Nat -> Id Nat (natAbs (intOfSignMag true mm)) mm) {
      | zero  => lambda d: refl
      | suc k => lambda d: refl }) zero    -- applied to a dummy so the match is not
                                           -- tail position (explicit motive allowed)

-- adding zero on the right is the identity — the `pos` case reduces to Nat's
-- `add_n_zero` (transported through the `pos` constructor by `ap`); the `negsuc`
-- case is definitional (diff 0 (suc n) = negsuc n).
def addI_zero : (i : Int) -> Id Int (addI i (pos zero)) i
  = lambda i: match i {
      | pos m    => ap Nat Int (lambda x: pos x) (add m zero) m (add_n_zero m)
      | negsuc n => refl }

-- negation is involutive: neg (neg i) = i.  The `pos` case must inspect the Nat
-- inside; an EXPLICIT dependent motive (`match m as mm return …`, ADR-015) refines
-- it directly — no helper def needed.
def negI_negI : (i : Int) -> Id Int (negI (negI i)) i
  = lambda i: match i {
      | pos m => match m as mm return (Id Int (negI (negI (pos mm))) (pos mm)) { | zero => refl | suc k => refl }
      | negsuc n => refl }

-- addI is commutative. Case-split both arguments; the cross-sign cases collapse
-- definitionally (both sides are the same `diff`), the same-sign cases reduce to
-- Nat's add_comm through the `pos`/`negsuc` constructor. The inner split (on the
-- SECOND argument) is a top-level helper so it gets its own dependent motive.
def addI_comm_posR : (j : Int) -> (m : Nat) -> Id Int (addI (pos m) j) (addI j (pos m))
  = lambda j m: match j {
      | pos n    => ap Nat Int (lambda x: pos x) (add m n) (add n m) (add_comm m n)
      | negsuc n => refl }

def addI_comm_negsucR : (j : Int) -> (m : Nat) -> Id Int (addI (negsuc m) j) (addI j (negsuc m))
  = lambda j m: match j {
      | pos n    => refl
      | negsuc n => ap Nat Int (lambda x: negsuc x) (add (suc m) n) (add (suc n) m)
                       (ap Nat Nat (lambda x: suc x) (add m n) (add n m) (add_comm m n)) }

def addI_comm : (i : Int) -> (j : Int) -> Id Int (addI i j) (addI j i)
  = lambda i j: match i { | pos m => addI_comm_posR j m | negsuc m => addI_comm_negsucR j m }

-- mulI is commutative. Case-split both signs (so `xor` and the sign/magnitude
-- projections reduce definitionally in each arm) and appeal to Nat's mul_comm;
-- the second-argument split is a top-level helper for its dependent motive.
-- (A direct proof via `xor a b = xor b a` is blocked: Bool `match` lowers to a
--  non-dependent `if`, so Bool properties can't yet be proved by case-refinement.)
def mulI_comm_posR : (j : Int) -> (m : Nat) -> Id Int (mulI (pos m) j) (mulI j (pos m))
  = lambda j m: match j {
      | pos n    => ap Nat Int (lambda x: pos x) (mul m n) (mul n m) (mul_comm m n)
      | negsuc n => ap Nat Int (lambda z: intOfSignMag true z)
                       (mul m (suc n)) (mul (suc n) m) (mul_comm m (suc n)) }

def mulI_comm_negsucR : (j : Int) -> (m : Nat) -> Id Int (mulI (negsuc m) j) (mulI j (negsuc m))
  = lambda j m: match j {
      | pos n    => ap Nat Int (lambda z: intOfSignMag true z)
                       (mul (suc m) n) (mul n (suc m)) (mul_comm (suc m) n)
      | negsuc n => ap Nat Int (lambda x: pos x)
                       (mul (suc m) (suc n)) (mul (suc n) (suc m)) (mul_comm (suc m) (suc n)) }

def mulI_comm : (i : Int) -> (j : Int) -> Id Int (mulI i j) (mulI j i)
  = lambda i j: match i { | pos m => mulI_comm_posR j m | negsuc m => mulI_comm_negsucR j m }

-- ============================================================================
-- Toward the ring axioms: (ℤ, +) is a commutative group. The diff-homomorphism
-- route (double induction on diff's two Nat args; `diff (suc j) (suc k) ≡ diff j k`
-- is definitional, so each suc/suc case IS the induction hypothesis — no sign
-- analysis, no comparison). See DECISIONS.md.
-- ============================================================================

-- diff n n = 0.  (suc case: diff (suc k) (suc k) ≡ diff k k, so it's the IH.)
def diff_n_n : (n : Nat) -> Id Int (diff n n) (pos zero)
  = lambda n: match n { | zero => refl | suc k => diff_n_n k }

-- diff m 0 = pos m.  (non-recursive; dummy application dodges the tail-match guard.)
def diff_m_0 : (m : Nat) -> Id Int (diff m zero) (pos m)
  = lambda m: (match m as mm return (Nat -> Id Int (diff mm zero) (pos mm)) {
      | zero  => lambda d: refl
      | suc k => lambda d: refl }) zero

-- ADDITIVE INVERSE:  i + (−i) = 0.  (This is the exact lemma the constructive-real
-- proof tier was blocked on — `subQ q q = 0` traces to it. First brick out.)
def addI_negI : (i : Int) -> Id Int (addI i (negI i)) zeroI
  = lambda i: match i {
      | pos m    => (match m as mm return (Id Int (addI (pos mm) (negI (pos mm))) zeroI) {
                       | zero  => refl                -- 0 + 0 = 0
                       | suc k => diff_n_n k })       -- (k+1) + −(k+1) ≡ diff k k = 0
      | negsuc n => diff_n_n n }                      -- −(n+1) + (n+1) ≡ diff n n = 0

-- (a+b) − (a+c) = b − c.  Induct a; clone of nat's sub_add_cancel_l.
def diff_cancel_l : (a : Nat) -> (b : Nat) -> (c : Nat) -> Id Int (diff (add a b) (add a c)) (diff b c)
  = lambda a b c: match a { | zero => refl | suc j => diff_cancel_l j b c }

-- WORKHORSE:  m + (n − o) = (m + n) − o.  Double induction: `n` decreasing (so it
-- comes first, per the recursion rule); `o` an inner explicit-motive match.
def add_diff_pos : (n : Nat) -> (o : Nat) -> (m : Nat)
  -> Id Int (addI (pos m) (diff n o)) (diff (add m n) o)
  = lambda n o m: match n {
      | zero => (match o as oo return (Id Int (addI (pos m) (diff zero oo)) (diff (add m zero) oo)) {
          | zero  => sym Int (diff (add m zero) zero) (pos (add m zero)) (diff_m_0 (add m zero))
          | suc k => ap Nat Int (lambda z: diff z (suc k)) m (add m zero)
                       (sym Nat (add m zero) m (add_n_zero m)) })
      | suc j => (match o as oo return (Id Int (addI (pos m) (diff (suc j) oo)) (diff (add m (suc j)) oo)) {
          | zero  => sym Int (diff (add m (suc j)) zero) (pos (add m (suc j))) (diff_m_0 (add m (suc j)))
          | suc k => trans Int (addI (pos m) (diff j k)) (diff (add m j) k) (diff (add m (suc j)) (suc k))
                       (add_diff_pos j k m)
                       (sym Int (diff (add m (suc j)) (suc k)) (diff (add m j) k)
                          (ap Nat Int (lambda z: diff z (suc k)) (add m (suc j)) (suc (add m j)) (add_suc m j))) }) }

-- mirror of the workhorse on the negative side:  −(m+1) + (n − o) = n − ((m+1)+o).
def add_diff_negsuc : (n : Nat) -> (o : Nat) -> (m : Nat)
  -> Id Int (addI (negsuc m) (diff n o)) (diff n (add (suc m) o))
  = lambda n o m: match n {
      | zero => (match o as oo return (Id Int (addI (negsuc m) (diff zero oo)) (diff zero (add (suc m) oo))) {
          | zero  => ap Nat Int (lambda z: diff zero z) (suc m) (add (suc m) zero)
                       (sym Nat (add (suc m) zero) (suc m) (add_n_zero (suc m)))
          | suc k => sym Int (diff zero (add (suc m) (suc k))) (negsuc (add (suc m) k))
                       (ap Nat Int (lambda z: diff zero z) (add (suc m) (suc k)) (suc (add (suc m) k))
                          (add_suc (suc m) k)) })
      | suc j => (match o as oo return (Id Int (addI (negsuc m) (diff (suc j) oo)) (diff (suc j) (add (suc m) oo))) {
          | zero  => ap Nat Int (lambda z: diff (suc j) z) (suc m) (add (suc m) zero)
                       (sym Nat (add (suc m) zero) (suc m) (add_n_zero (suc m)))
          | suc k => trans Int (addI (negsuc m) (diff j k)) (diff j (add (suc m) k)) (diff (suc j) (add (suc m) (suc k)))
                       (add_diff_negsuc j k m)
                       (sym Int (diff (suc j) (add (suc m) (suc k))) (diff j (add (suc m) k))
                          (ap Nat Int (lambda z: diff (suc j) z) (add (suc m) (suc k)) (suc (add (suc m) k))
                             (add_suc (suc m) k))) }) }

-- ---- ASSOCIATIVITY of + : the 8 sign-cases, dispatched through a helper tree
-- (each match refines its scrutinee via the def's own annotation; the mixed cases
-- flip a stuck `addI (diff …) _` with addI_comm, then use the workhorses).

def assocPP : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (addI (addI (pos p) (pos q)) c) (addI (pos p) (addI (pos q) c))
  = lambda p q c: match c {
      | pos r    => ap Nat Int (lambda z: pos z) (add (add p q) r) (add p (add q r)) (add_assoc p q r)
      | negsuc r => sym Int (addI (pos p) (diff q (suc r))) (diff (add p q) (suc r)) (add_diff_pos q (suc r) p) }

def assocPN : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (addI (addI (pos p) (negsuc q)) c) (addI (pos p) (addI (negsuc q) c))
  = lambda p q c: match c {
      | pos r =>
          trans Int (addI (diff p (suc q)) (pos r)) (addI (pos r) (diff p (suc q))) (addI (pos p) (diff r (suc q)))
            (addI_comm (diff p (suc q)) (pos r))
            (trans Int (addI (pos r) (diff p (suc q))) (diff (add r p) (suc q)) (addI (pos p) (diff r (suc q)))
               (add_diff_pos p (suc q) r)
               (trans Int (diff (add r p) (suc q)) (diff (add p r) (suc q)) (addI (pos p) (diff r (suc q)))
                  (ap Nat Int (lambda z: diff z (suc q)) (add r p) (add p r) (add_comm r p))
                  (sym Int (addI (pos p) (diff r (suc q))) (diff (add p r) (suc q)) (add_diff_pos r (suc q) p))))
      | negsuc r =>
          trans Int (addI (diff p (suc q)) (negsuc r)) (addI (negsuc r) (diff p (suc q))) (diff p (suc (add (suc q) r)))
            (addI_comm (diff p (suc q)) (negsuc r))
            (trans Int (addI (negsuc r) (diff p (suc q))) (diff p (add (suc r) (suc q))) (diff p (suc (add (suc q) r)))
               (add_diff_negsuc p (suc q) r)
               (ap Nat Int (lambda z: diff p z) (add (suc r) (suc q)) (suc (add (suc q) r))
                  (ap Nat Nat (lambda z: suc z) (add r (suc q)) (suc (add q r))
                     (trans Nat (add r (suc q)) (suc (add r q)) (suc (add q r))
                        (add_suc r q)
                        (ap Nat Nat (lambda z: suc z) (add r q) (add q r) (add_comm r q)))))) }

def assocNP : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (addI (addI (negsuc p) (pos q)) c) (addI (negsuc p) (addI (pos q) c))
  = lambda p q c: match c {
      | pos r =>
          trans Int (addI (diff q (suc p)) (pos r)) (addI (pos r) (diff q (suc p))) (diff (add q r) (suc p))
            (addI_comm (diff q (suc p)) (pos r))
            (trans Int (addI (pos r) (diff q (suc p))) (diff (add r q) (suc p)) (diff (add q r) (suc p))
               (add_diff_pos q (suc p) r)
               (ap Nat Int (lambda z: diff z (suc p)) (add r q) (add q r) (add_comm r q)))
      | negsuc r =>
          trans Int (addI (diff q (suc p)) (negsuc r)) (addI (negsuc r) (diff q (suc p))) (addI (negsuc p) (diff q (suc r)))
            (addI_comm (diff q (suc p)) (negsuc r))
            (trans Int (addI (negsuc r) (diff q (suc p))) (diff q (add (suc r) (suc p))) (addI (negsuc p) (diff q (suc r)))
               (add_diff_negsuc q (suc p) r)
               (trans Int (diff q (add (suc r) (suc p))) (diff q (add (suc p) (suc r))) (addI (negsuc p) (diff q (suc r)))
                  (ap Nat Int (lambda z: diff q z) (add (suc r) (suc p)) (add (suc p) (suc r)) (add_comm (suc r) (suc p)))
                  (sym Int (addI (negsuc p) (diff q (suc r))) (diff q (add (suc p) (suc r))) (add_diff_negsuc q (suc r) p)))) }

def assocNN : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (addI (addI (negsuc p) (negsuc q)) c) (addI (negsuc p) (addI (negsuc q) c))
  = lambda p q c: match c {
      | pos r =>
          trans Int (diff r (suc (add (suc p) q))) (diff r (add (suc p) (suc q))) (addI (negsuc p) (diff r (suc q)))
            (ap Nat Int (lambda z: diff r z) (suc (add (suc p) q)) (add (suc p) (suc q))
               (sym Nat (add (suc p) (suc q)) (suc (add (suc p) q)) (add_suc (suc p) q)))
            (sym Int (addI (negsuc p) (diff r (suc q))) (diff r (add (suc p) (suc q))) (add_diff_negsuc r (suc q) p))
      | negsuc r =>
          ap Nat Int (lambda z: negsuc z) (add (suc (add (suc p) q)) r) (add (suc p) (add (suc q) r))
            (ap Nat Nat (lambda z: suc z) (add (add (suc p) q) r) (add p (add (suc q) r))
               (trans Nat (add (add (suc p) q) r) (add (suc p) (add q r)) (add p (add (suc q) r))
                  (add_assoc (suc p) q r)
                  (sym Nat (add p (add (suc q) r)) (add (suc p) (add q r)) (add_suc p (add q r))))) }

def assocP : (p : Nat) -> (b : Int) -> (c : Int)
  -> Id Int (addI (addI (pos p) b) c) (addI (pos p) (addI b c))
  = lambda p b c: match b { | pos q => assocPP p q c | negsuc q => assocPN p q c }
def assocN : (p : Nat) -> (b : Int) -> (c : Int)
  -> Id Int (addI (addI (negsuc p) b) c) (addI (negsuc p) (addI b c))
  = lambda p b c: match b { | pos q => assocNP p q c | negsuc q => assocNN p q c }

def addI_assoc : (a : Int) -> (b : Int) -> (c : Int) -> Id Int (addI (addI a b) c) (addI a (addI b c))
  = lambda a b c: match a { | pos p => assocP p b c | negsuc p => assocN p b c }

-- ---- multiplicative units and absorbing zero ------------------------------
-- 0·i = 0  (mul zero X ≡ 0 definitionally, so both cases are refl).
def mulI_zero_l : (i : Int) -> Id Int (mulI zeroI i) zeroI
  = lambda i: match i { | pos m => refl | negsuc n => refl }
-- i·0 = 0  (mul X zero is stuck on variable X, so rewrite with mul_n_zero).
def mulI_zero_r : (i : Int) -> Id Int (mulI i zeroI) zeroI
  = lambda i: match i {
      | pos m    => ap Nat Int (lambda z: pos z) (mul m zero) zero (mul_n_zero m)
      | negsuc n => ap Nat Int (lambda z: intOfSignMag true z) (mul (suc n) zero) zero (mul_n_zero (suc n)) }
-- 1·i = i  (mul (suc zero) X ≡ add X zero, so rewrite with add_n_zero).
def mulI_one_l : (i : Int) -> Id Int (mulI oneI i) i
  = lambda i: match i {
      | pos m    => ap Nat Int (lambda z: pos z)    (add m zero) m (add_n_zero m)
      | negsuc n => ap Nat Int (lambda z: negsuc z) (add n zero) n (add_n_zero n) }
-- i·1 = i.
def mulI_one_r : (i : Int) -> Id Int (mulI i oneI) i
  = lambda i: match i {
      | pos m    => ap Nat Int (lambda z: pos z) (mul m (suc zero)) m (mul_n_one m)
      | negsuc n => ap Nat Int (lambda z: intOfSignMag true z) (mul (suc n) (suc zero)) (suc n) (mul_n_one (suc n)) }

-- bridge: (signed-neg a) · (pos b) = signed-neg (a·b). Casing a keeps the sign literal.
def mulI_intSMtrue_pos : (a : Nat) -> (b : Nat)
  -> Id Int (mulI (intOfSignMag true a) (pos b)) (intOfSignMag true (mul a b))
  = lambda a b: (match a as aa return (Nat -> Id Int (mulI (intOfSignMag true aa) (pos b)) (intOfSignMag true (mul aa b))) {
      | zero  => lambda d: refl
      | suc k => lambda d: refl }) zero

-- ---- ASSOCIATIVITY of · : 8 sign-cases via a helper tree, splitting a
-- pos-magnitude into zero/suc exactly where a mixed-sign product's magnitude is
-- stuck on it (integer splits make isNeg/xor literal; magnitude splits make
-- intOfSignMag true a constructor — the Bool-elim gap is never faced). See ADR.

-- pos · pos : c=pos is pure mul_assoc; c=negsuc splits q (RHS inner mul q (suc r)).
def mAssocPP : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (mulI (mulI (pos p) (pos q)) c) (mulI (pos p) (mulI (pos q) c))
  = lambda p q c: match c {
      | pos r    => ap Nat Int (lambda z: pos z) (mul (mul p q) r) (mul p (mul q r)) (mul_assoc p q r)
      | negsuc r => (match q as qq return
          (Id Int (mulI (mulI (pos p) (pos qq)) (negsuc r)) (mulI (pos p) (mulI (pos qq) (negsuc r)))) {
          | zero    => transp Nat (lambda z: Id Int (intOfSignMag true (mul z (suc r))) (pos z))
                         zero (mul p zero) (sym Nat (mul p zero) zero (mul_n_zero p)) refl
          | suc q2  => ap Nat Int (lambda z: intOfSignMag true z)
                         (mul (mul p (suc q2)) (suc r)) (mul p (mul (suc q2) (suc r)))
                         (mul_assoc p (suc q2) (suc r)) }) }

-- negsuc · negsuc : c=negsuc is pure mul_assoc (through intOfSignMag true);
-- c=pos splits r (RHS inner mul (suc q) r is stuck on r).
def mAssocNN : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (mulI (mulI (negsuc p) (negsuc q)) c) (mulI (negsuc p) (mulI (negsuc q) c))
  = lambda p q c: match c {
      | negsuc r => ap Nat Int (lambda z: intOfSignMag true z)
                      (mul (mul (suc p) (suc q)) (suc r)) (mul (suc p) (mul (suc q) (suc r)))
                      (mul_assoc (suc p) (suc q) (suc r))
      | pos r => (match r as rr return
          (Id Int (mulI (mulI (negsuc p) (negsuc q)) (pos rr)) (mulI (negsuc p) (mulI (negsuc q) (pos rr)))) {
          | zero =>
              trans Int (mulI (mulI (negsuc p) (negsuc q)) (pos zero)) (pos zero) (mulI (negsuc p) (mulI (negsuc q) (pos zero)))
                (ap Nat Int (lambda z: pos z) (mul (mul (suc p) (suc q)) zero) zero (mul_n_zero (mul (suc p) (suc q))))
                (sym Int (mulI (negsuc p) (mulI (negsuc q) (pos zero))) (pos zero)
                   (trans Int (mulI (negsuc p) (mulI (negsuc q) (pos zero))) (intOfSignMag true (mul (suc p) zero)) (pos zero)
                      (ap Nat Int (lambda z: mulI (negsuc p) (intOfSignMag true z)) (mul (suc q) zero) zero (mul_n_zero (suc q)))
                      (ap Nat Int (lambda z: intOfSignMag true z) (mul (suc p) zero) zero (mul_n_zero (suc p)))))
          | suc r2 => ap Nat Int (lambda z: pos z)
                        (mul (mul (suc p) (suc q)) (suc r2)) (mul (suc p) (mul (suc q) (suc r2)))
                        (mul_assoc (suc p) (suc q) (suc r2)) }) }

-- pos · negsuc : c=pos splits BOTH p and r (both inner products stuck); c=negsuc
-- splits p (RHS inner negsuc·negsuc reduces).
def mAssocPN : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (mulI (mulI (pos p) (negsuc q)) c) (mulI (pos p) (mulI (negsuc q) c))
  = lambda p q c: match c {
      | pos r => (match p as pp return
          (Id Int (mulI (mulI (pos pp) (negsuc q)) (pos r)) (mulI (pos pp) (mulI (negsuc q) (pos r)))) {
          | zero => (match r as rr return
              (Id Int (mulI (mulI (pos zero) (negsuc q)) (pos rr)) (mulI (pos zero) (mulI (negsuc q) (pos rr)))) {
              | zero => sym Int (mulI (pos zero) (intOfSignMag true (mul (suc q) zero))) (pos zero)
                          (ap Nat Int (lambda z: mulI (pos zero) (intOfSignMag true z)) (mul (suc q) zero) zero (mul_n_zero (suc q)))
              | suc r2 => refl })
          | suc p2 => (match r as rr return
              (Id Int (mulI (mulI (pos (suc p2)) (negsuc q)) (pos rr)) (mulI (pos (suc p2)) (mulI (negsuc q) (pos rr)))) {
              | zero =>
                  trans Int (mulI (mulI (pos (suc p2)) (negsuc q)) (pos zero)) (pos zero) (mulI (pos (suc p2)) (mulI (negsuc q) (pos zero)))
                    (ap Nat Int (lambda z: intOfSignMag true z) (mul (mul (suc p2) (suc q)) zero) zero (mul_n_zero (mul (suc p2) (suc q))))
                    (sym Int (mulI (pos (suc p2)) (mulI (negsuc q) (pos zero))) (pos zero)
                       (trans Int (mulI (pos (suc p2)) (mulI (negsuc q) (pos zero))) (pos (mul (suc p2) zero)) (pos zero)
                          (ap Nat Int (lambda z: mulI (pos (suc p2)) (intOfSignMag true z)) (mul (suc q) zero) zero (mul_n_zero (suc q)))
                          (ap Nat Int (lambda z: pos z) (mul (suc p2) zero) zero (mul_n_zero (suc p2)))))
              | suc r2 => ap Nat Int (lambda z: intOfSignMag true z)
                            (mul (mul (suc p2) (suc q)) (suc r2)) (mul (suc p2) (mul (suc q) (suc r2)))
                            (mul_assoc (suc p2) (suc q) (suc r2)) }) })
      | negsuc r => (match p as pp return
          (Id Int (mulI (mulI (pos pp) (negsuc q)) (negsuc r)) (mulI (pos pp) (mulI (negsuc q) (negsuc r)))) {
          | zero => refl
          | suc p2 => ap Nat Int (lambda z: pos z)
                        (mul (mul (suc p2) (suc q)) (suc r)) (mul (suc p2) (mul (suc q) (suc r)))
                        (mul_assoc (suc p2) (suc q) (suc r)) }) }

-- negsuc · pos : both c-cases split q (the inner mul (suc p) q is stuck on q).
def mAssocNP : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (mulI (mulI (negsuc p) (pos q)) c) (mulI (negsuc p) (mulI (pos q) c))
  = lambda p q c: match c {
      | pos r => (match q as qq return
          (Id Int (mulI (mulI (negsuc p) (pos qq)) (pos r)) (mulI (negsuc p) (mulI (pos qq) (pos r)))) {
          | zero =>
              trans Int (mulI (mulI (negsuc p) (pos zero)) (pos r)) (pos zero) (mulI (negsuc p) (mulI (pos zero) (pos r)))
                (ap Nat Int (lambda z: mulI (intOfSignMag true z) (pos r)) (mul (suc p) zero) zero (mul_n_zero (suc p)))
                (sym Int (mulI (negsuc p) (mulI (pos zero) (pos r))) (pos zero)
                   (ap Nat Int (lambda z: intOfSignMag true z) (mul (suc p) zero) zero (mul_n_zero (suc p))))
          | suc q2 => ap Nat Int (lambda z: intOfSignMag true z)
                        (mul (mul (suc p) (suc q2)) r) (mul (suc p) (mul (suc q2) r)) (mul_assoc (suc p) (suc q2) r) })
      | negsuc r => (match q as qq return
          (Id Int (mulI (mulI (negsuc p) (pos qq)) (negsuc r)) (mulI (negsuc p) (mulI (pos qq) (negsuc r)))) {
          | zero =>
              trans Int (mulI (mulI (negsuc p) (pos zero)) (negsuc r)) (pos zero) (mulI (negsuc p) (mulI (pos zero) (negsuc r)))
                (ap Nat Int (lambda z: mulI (intOfSignMag true z) (negsuc r)) (mul (suc p) zero) zero (mul_n_zero (suc p)))
                (sym Int (mulI (negsuc p) (mulI (pos zero) (negsuc r))) (pos zero)
                   (ap Nat Int (lambda z: intOfSignMag true z) (mul (suc p) zero) zero (mul_n_zero (suc p))))
          | suc q2 => ap Nat Int (lambda z: pos z)
                        (mul (mul (suc p) (suc q2)) (suc r)) (mul (suc p) (mul (suc q2) (suc r)))
                        (mul_assoc (suc p) (suc q2) (suc r)) }) }

def mAssocP : (p : Nat) -> (b : Int) -> (c : Int)
  -> Id Int (mulI (mulI (pos p) b) c) (mulI (pos p) (mulI b c))
  = lambda p b c: match b { | pos q => mAssocPP p q c | negsuc q => mAssocPN p q c }
def mAssocN : (p : Nat) -> (b : Int) -> (c : Int)
  -> Id Int (mulI (mulI (negsuc p) b) c) (mulI (negsuc p) (mulI b c))
  = lambda p b c: match b { | pos q => mAssocNP p q c | negsuc q => mAssocNN p q c }

def mulI_assoc : (a : Int) -> (b : Int) -> (c : Int) -> Id Int (mulI (mulI a b) c) (mulI a (mulI b c))
  = lambda a b c: match a { | pos p => mAssocP p b c | negsuc p => mAssocN p b c }

-- ---- distributivity workhorses (mul over diff): toward mulI-over-addI --------
-- m·(n−o) = m·n − m·o.  Same double-induction template as add_diff_pos; the
-- suc/suc case is the IH, glued with mul_suc (m·suc = m + m··) and diff_cancel_l.
def mul_diff_pos : (n : Nat) -> (o : Nat) -> (m : Nat)
  -> Id Int (mulI (pos m) (diff n o)) (diff (mul m n) (mul m o))
  = lambda n o m: match n {
      | zero => (match o as oo return (Id Int (mulI (pos m) (diff zero oo)) (diff (mul m zero) (mul m oo))) {
          | zero => trans Int (pos (mul m zero)) (pos zero) (diff (mul m zero) (mul m zero))
                      (ap Nat Int (lambda z: pos z) (mul m zero) zero (mul_n_zero m))
                      (sym Int (diff (mul m zero) (mul m zero)) (pos zero) (diff_n_n (mul m zero)))
          | suc k => sym Int (diff (mul m zero) (mul m (suc k))) (intOfSignMag true (mul m (suc k)))
                       (ap Nat Int (lambda z: diff z (mul m (suc k))) (mul m zero) zero (mul_n_zero m)) })
      | suc j => (match o as oo return (Id Int (mulI (pos m) (diff (suc j) oo)) (diff (mul m (suc j)) (mul m oo))) {
          | zero => trans Int (pos (mul m (suc j))) (diff (mul m (suc j)) zero) (diff (mul m (suc j)) (mul m zero))
                      (sym Int (diff (mul m (suc j)) zero) (pos (mul m (suc j))) (diff_m_0 (mul m (suc j))))
                      (ap Nat Int (lambda z: diff (mul m (suc j)) z) zero (mul m zero) (sym Nat (mul m zero) zero (mul_n_zero m)))
          | suc k => trans Int (mulI (pos m) (diff j k)) (diff (mul m j) (mul m k)) (diff (mul m (suc j)) (mul m (suc k)))
                       (mul_diff_pos j k m)
                       (sym Int (diff (mul m (suc j)) (mul m (suc k))) (diff (mul m j) (mul m k))
                          (trans Int (diff (mul m (suc j)) (mul m (suc k))) (diff (add m (mul m j)) (add m (mul m k))) (diff (mul m j) (mul m k))
                             (trans Int (diff (mul m (suc j)) (mul m (suc k))) (diff (add m (mul m j)) (mul m (suc k))) (diff (add m (mul m j)) (add m (mul m k)))
                                (ap Nat Int (lambda z: diff z (mul m (suc k))) (mul m (suc j)) (add m (mul m j)) (mul_suc m j))
                                (ap Nat Int (lambda z: diff (add m (mul m j)) z) (mul m (suc k)) (add m (mul m k)) (mul_suc m k)))
                             (diff_cancel_l m (mul m j) (mul m k)))) }) }

-- −(m+1)·(n−o) = (m+1)·o − (m+1)·n  (the diff swaps, since the factor is negative).
def mul_diff_negsuc : (n : Nat) -> (o : Nat) -> (m : Nat)
  -> Id Int (mulI (negsuc m) (diff n o)) (diff (mul (suc m) o) (mul (suc m) n))
  = lambda n o m: match n {
      | zero => (match o as oo return (Id Int (mulI (negsuc m) (diff zero oo)) (diff (mul (suc m) oo) (mul (suc m) zero))) {
          | zero => trans Int (intOfSignMag true (mul (suc m) zero)) (pos zero) (diff (mul (suc m) zero) (mul (suc m) zero))
                      (ap Nat Int (lambda z: intOfSignMag true z) (mul (suc m) zero) zero (mul_n_zero (suc m)))
                      (sym Int (diff (mul (suc m) zero) (mul (suc m) zero)) (pos zero) (diff_n_n (mul (suc m) zero)))
          | suc k => trans Int (pos (mul (suc m) (suc k))) (diff (mul (suc m) (suc k)) zero) (diff (mul (suc m) (suc k)) (mul (suc m) zero))
                       (sym Int (diff (mul (suc m) (suc k)) zero) (pos (mul (suc m) (suc k))) (diff_m_0 (mul (suc m) (suc k))))
                       (ap Nat Int (lambda z: diff (mul (suc m) (suc k)) z) zero (mul (suc m) zero) (sym Nat (mul (suc m) zero) zero (mul_n_zero (suc m)))) })
      | suc j => (match o as oo return (Id Int (mulI (negsuc m) (diff (suc j) oo)) (diff (mul (suc m) oo) (mul (suc m) (suc j)))) {
          | zero => sym Int (diff (mul (suc m) zero) (mul (suc m) (suc j))) (intOfSignMag true (mul (suc m) (suc j)))
                      (ap Nat Int (lambda z: diff z (mul (suc m) (suc j))) (mul (suc m) zero) zero (mul_n_zero (suc m)))
          | suc k => trans Int (mulI (negsuc m) (diff j k)) (diff (mul (suc m) k) (mul (suc m) j)) (diff (mul (suc m) (suc k)) (mul (suc m) (suc j)))
                       (mul_diff_negsuc j k m)
                       (sym Int (diff (mul (suc m) (suc k)) (mul (suc m) (suc j))) (diff (mul (suc m) k) (mul (suc m) j))
                          (trans Int (diff (mul (suc m) (suc k)) (mul (suc m) (suc j))) (diff (add (suc m) (mul (suc m) k)) (add (suc m) (mul (suc m) j))) (diff (mul (suc m) k) (mul (suc m) j))
                             (trans Int (diff (mul (suc m) (suc k)) (mul (suc m) (suc j))) (diff (add (suc m) (mul (suc m) k)) (mul (suc m) (suc j))) (diff (add (suc m) (mul (suc m) k)) (add (suc m) (mul (suc m) j)))
                                (ap Nat Int (lambda z: diff z (mul (suc m) (suc j))) (mul (suc m) (suc k)) (add (suc m) (mul (suc m) k)) (mul_suc (suc m) k))
                                (ap Nat Int (lambda z: diff (add (suc m) (mul (suc m) k)) z) (mul (suc m) (suc j)) (add (suc m) (mul (suc m) j)) (mul_suc (suc m) j)))
                             (diff_cancel_l (suc m) (mul (suc m) k) (mul (suc m) j)))) }) }

-- addI IS diff-additive:  (a−b) + (c−d) = (a+c) − (b+d).  The load-bearing bridge.
-- Induct a then b; three of four cases are the workhorses near-refl, the fourth a
-- single diff_m_0 transport; the suc/suc case is exactly the IH.
def diff_add : (a : Nat) -> (b : Nat) -> (c : Nat) -> (d : Nat)
  -> Id Int (addI (diff a b) (diff c d)) (diff (add a c) (add b d))
  = lambda a b c d: match a {
      | zero => (match b as bb return (Id Int (addI (diff zero bb) (diff c d)) (diff (add zero c) (add bb d))) {
          | zero  => add_diff_pos c d zero
          | suc k => add_diff_negsuc c d k })
      | suc j => (match b as bb return (Id Int (addI (diff (suc j) bb) (diff c d)) (diff (add (suc j) c) (add bb d))) {
          | zero  => trans Int (addI (diff (suc j) zero) (diff c d)) (addI (pos (suc j)) (diff c d)) (diff (add (suc j) c) (add zero d))
                       (ap Int Int (lambda z: addI z (diff c d)) (diff (suc j) zero) (pos (suc j)) (diff_m_0 (suc j)))
                       (add_diff_pos c d (suc j))
          | suc k => diff_add j k c d }) }

-- ---- DISTRIBUTIVITY of · over + : the last ring axiom ------------------------
-- Route B: convert both sides to `diff` and glue with diff_add + mul_diff_* +
-- mul_add_distrib_l. Same-sign (b,c) reduce addI to pos/negsuc (Nat distrib);
-- mixed-sign reduce addI to a diff (the mul_diff workhorses). 8 leaves.

def dstPP : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (mulI (pos p) (addI (pos q) c)) (addI (mulI (pos p) (pos q)) (mulI (pos p) c))
  = lambda p q c: match c {
      | pos r => ap Nat Int (lambda z: pos z) (mul p (add q r)) (add (mul p q) (mul p r)) (mul_add_distrib_l p q r)
      | negsuc r =>
          trans Int (mulI (pos p) (addI (pos q) (negsuc r))) (diff (mul p q) (mul p (suc r))) (addI (mulI (pos p) (pos q)) (mulI (pos p) (negsuc r)))
            (mul_diff_pos q (suc r) p)
            (sym Int (addI (mulI (pos p) (pos q)) (mulI (pos p) (negsuc r))) (diff (mul p q) (mul p (suc r)))
               (trans Int (addI (pos (mul p q)) (intOfSignMag true (mul p (suc r)))) (diff (add (mul p q) zero) (mul p (suc r))) (diff (mul p q) (mul p (suc r)))
                  (add_diff_pos zero (mul p (suc r)) (mul p q))
                  (ap Nat Int (lambda z: diff z (mul p (suc r))) (add (mul p q) zero) (mul p q) (add_n_zero (mul p q))))) }

def dstPN : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (mulI (pos p) (addI (negsuc q) c)) (addI (mulI (pos p) (negsuc q)) (mulI (pos p) c))
  = lambda p q c: match c {
      | pos r =>
          trans Int (mulI (pos p) (addI (negsuc q) (pos r))) (diff (mul p r) (mul p (suc q))) (addI (mulI (pos p) (negsuc q)) (mulI (pos p) (pos r)))
            (mul_diff_pos r (suc q) p)
            (sym Int (addI (mulI (pos p) (negsuc q)) (mulI (pos p) (pos r))) (diff (mul p r) (mul p (suc q)))
               (trans Int (addI (intOfSignMag true (mul p (suc q))) (pos (mul p r))) (addI (pos (mul p r)) (intOfSignMag true (mul p (suc q)))) (diff (mul p r) (mul p (suc q)))
                  (addI_comm (intOfSignMag true (mul p (suc q))) (pos (mul p r)))
                  (trans Int (addI (pos (mul p r)) (intOfSignMag true (mul p (suc q)))) (diff (add (mul p r) zero) (mul p (suc q))) (diff (mul p r) (mul p (suc q)))
                     (add_diff_pos zero (mul p (suc q)) (mul p r))
                     (ap Nat Int (lambda z: diff z (mul p (suc q))) (add (mul p r) zero) (mul p r) (add_n_zero (mul p r))))))
      | negsuc r =>
          trans Int (mulI (pos p) (addI (negsuc q) (negsuc r))) (diff zero (add (mul p (suc q)) (mul p (suc r)))) (addI (mulI (pos p) (negsuc q)) (mulI (pos p) (negsuc r)))
            (ap Nat Int (lambda z: diff zero z) (mul p (suc (add (suc q) r))) (add (mul p (suc q)) (mul p (suc r)))
               (trans Nat (mul p (suc (add (suc q) r))) (mul p (add (suc q) (suc r))) (add (mul p (suc q)) (mul p (suc r)))
                  (ap Nat Nat (lambda z: mul p z) (suc (add (suc q) r)) (add (suc q) (suc r)) (sym Nat (add (suc q) (suc r)) (suc (add (suc q) r)) (add_suc (suc q) r)))
                  (mul_add_distrib_l p (suc q) (suc r))))
            (sym Int (addI (mulI (pos p) (negsuc q)) (mulI (pos p) (negsuc r))) (diff zero (add (mul p (suc q)) (mul p (suc r))))
               (diff_add zero (mul p (suc q)) zero (mul p (suc r)))) }

def dstNP : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (mulI (negsuc p) (addI (pos q) c)) (addI (mulI (negsuc p) (pos q)) (mulI (negsuc p) c))
  = lambda p q c: match c {
      | pos r =>
          trans Int (mulI (negsuc p) (addI (pos q) (pos r))) (diff zero (add (mul (suc p) q) (mul (suc p) r))) (addI (mulI (negsuc p) (pos q)) (mulI (negsuc p) (pos r)))
            (ap Nat Int (lambda z: diff zero z) (mul (suc p) (add q r)) (add (mul (suc p) q) (mul (suc p) r)) (mul_add_distrib_l (suc p) q r))
            (sym Int (addI (mulI (negsuc p) (pos q)) (mulI (negsuc p) (pos r))) (diff zero (add (mul (suc p) q) (mul (suc p) r)))
               (diff_add zero (mul (suc p) q) zero (mul (suc p) r)))
      | negsuc r =>
          trans Int (mulI (negsuc p) (addI (pos q) (negsuc r))) (diff (mul (suc p) (suc r)) (mul (suc p) q)) (addI (mulI (negsuc p) (pos q)) (mulI (negsuc p) (negsuc r)))
            (mul_diff_negsuc q (suc r) p)
            (sym Int (addI (mulI (negsuc p) (pos q)) (mulI (negsuc p) (negsuc r))) (diff (mul (suc p) (suc r)) (mul (suc p) q))
               (trans Int (addI (intOfSignMag true (mul (suc p) q)) (pos (mul (suc p) (suc r)))) (addI (pos (mul (suc p) (suc r))) (intOfSignMag true (mul (suc p) q))) (diff (mul (suc p) (suc r)) (mul (suc p) q))
                  (addI_comm (intOfSignMag true (mul (suc p) q)) (pos (mul (suc p) (suc r))))
                  (trans Int (addI (pos (mul (suc p) (suc r))) (intOfSignMag true (mul (suc p) q))) (diff (add (mul (suc p) (suc r)) zero) (mul (suc p) q)) (diff (mul (suc p) (suc r)) (mul (suc p) q))
                     (add_diff_pos zero (mul (suc p) q) (mul (suc p) (suc r)))
                     (ap Nat Int (lambda z: diff z (mul (suc p) q)) (add (mul (suc p) (suc r)) zero) (mul (suc p) (suc r)) (add_n_zero (mul (suc p) (suc r))))))) }

def dstNN : (p : Nat) -> (q : Nat) -> (c : Int)
  -> Id Int (mulI (negsuc p) (addI (negsuc q) c)) (addI (mulI (negsuc p) (negsuc q)) (mulI (negsuc p) c))
  = lambda p q c: match c {
      | pos r =>
          trans Int (mulI (negsuc p) (addI (negsuc q) (pos r))) (diff (mul (suc p) (suc q)) (mul (suc p) r)) (addI (mulI (negsuc p) (negsuc q)) (mulI (negsuc p) (pos r)))
            (mul_diff_negsuc r (suc q) p)
            (sym Int (addI (mulI (negsuc p) (negsuc q)) (mulI (negsuc p) (pos r))) (diff (mul (suc p) (suc q)) (mul (suc p) r))
               (trans Int (addI (pos (mul (suc p) (suc q))) (intOfSignMag true (mul (suc p) r))) (diff (add (mul (suc p) (suc q)) zero) (mul (suc p) r)) (diff (mul (suc p) (suc q)) (mul (suc p) r))
                  (add_diff_pos zero (mul (suc p) r) (mul (suc p) (suc q)))
                  (ap Nat Int (lambda z: diff z (mul (suc p) r)) (add (mul (suc p) (suc q)) zero) (mul (suc p) (suc q)) (add_n_zero (mul (suc p) (suc q))))))
      | negsuc r =>
          ap Nat Int (lambda z: pos z) (mul (suc p) (suc (add (suc q) r))) (add (mul (suc p) (suc q)) (mul (suc p) (suc r)))
            (trans Nat (mul (suc p) (suc (add (suc q) r))) (mul (suc p) (add (suc q) (suc r))) (add (mul (suc p) (suc q)) (mul (suc p) (suc r)))
               (ap Nat Nat (lambda z: mul (suc p) z) (suc (add (suc q) r)) (add (suc q) (suc r)) (sym Nat (add (suc q) (suc r)) (suc (add (suc q) r)) (add_suc (suc q) r)))
               (mul_add_distrib_l (suc p) (suc q) (suc r))) }

def dstP : (p : Nat) -> (b : Int) -> (c : Int)
  -> Id Int (mulI (pos p) (addI b c)) (addI (mulI (pos p) b) (mulI (pos p) c))
  = lambda p b c: match b { | pos q => dstPP p q c | negsuc q => dstPN p q c }
def dstN : (p : Nat) -> (b : Int) -> (c : Int)
  -> Id Int (mulI (negsuc p) (addI b c)) (addI (mulI (negsuc p) b) (mulI (negsuc p) c))
  = lambda p b c: match b { | pos q => dstNP p q c | negsuc q => dstNN p q c }

def mulI_distrib_l : (a : Int) -> (b : Int) -> (c : Int)
  -> Id Int (mulI a (addI b c)) (addI (mulI a b) (mulI a c))
  = lambda a b c: match a { | pos p => dstP p b c | negsuc p => dstN p b c }

-- right distributivity is free: commute all three products through mulI_comm.
def mulI_distrib_r : (a : Int) -> (b : Int) -> (c : Int)
  -> Id Int (mulI (addI a b) c) (addI (mulI a c) (mulI b c))
  = lambda a b c:
      trans Int (mulI (addI a b) c) (mulI c (addI a b)) (addI (mulI a c) (mulI b c))
        (mulI_comm (addI a b) c)
        (trans Int (mulI c (addI a b)) (addI (mulI c a) (mulI c b)) (addI (mulI a c) (mulI b c))
           (mulI_distrib_l c a b)
           (trans Int (addI (mulI c a) (mulI c b)) (addI (mulI a c) (mulI c b)) (addI (mulI a c) (mulI b c))
              (ap Int Int (lambda z: addI z (mulI c b)) (mulI c a) (mulI a c) (mulI_comm c a))
              (ap Int Int (lambda z: addI (mulI a c) z) (mulI c b) (mulI b c) (mulI_comm c b))))

-- ============================================================================
-- PROOF STATUS (honest record — see DECISIONS.md ADR-013).
--
-- The "nested dependent motive" gap (a `match` inside a constructor case can't
-- refine its goal) does NOT block us: factor the inner match into a top-level
-- helper def, whose own annotation supplies the dependent motive (see
-- `negI_negI_pos` above). So these are provable with today's kernel — it is
-- ordinary formalization work, not a missing feature.
--
-- Proved here: natAbs_pos, addI_zero (via Nat's add_n_zero), negI_negI (via a
-- helper), addI_comm and mulI_comm (via Nat's add_comm / mul_comm; cross-sign
-- cases collapse definitionally). std/nat.kan now proves add_suc, add_comm,
-- add_swap, mul_n_zero, mul_suc, mul_comm.
--
-- A kernel gap found along the way: Bool `match` lowers to a NON-dependent `if`,
-- so a Bool property (e.g. `xor a b = xor b a`) can't be proved by casing on the
-- Bool. A dependent Bool eliminator (or `if … return`) would fix it; meanwhile we
-- route around it (mulI_comm case-splits the *integers*, so `xor` reduces).
--
-- DONE since (milestone 2, stage 3): verified Euclidean division on Nat —
-- std/divmod.kan proves  divmodI : (a b) -> 0<b -> Σq Σr. (q·b+r = a) × (r<b),
-- via a fuel-Euclid whose fuel-sufficiency is proved by induction (Le a fuel,
-- discharged by le_refl at the wrapper). The order/impossibility toolkit it
-- needed (leDec, le_zero_eq, suc_ne_zero, sub_lt, fuel_dec) is in std/order.kan.
-- (Known: reducing divmodI numerically is exponential — undiagnosed evaluator
-- sharing issue; the compute path is the `ndiv` primitive, see divmod.kan.)
--
-- DONE since (milestone 2, stage 4): the divisibility algebra + the Euclid step.
-- std/nat.kan now proves mul associativity + right-distributivity over add and
-- monus (mul_assoc, mul_add_distrib_r, mul_sub_distrib_r, sub_add_cancel_l);
-- std/order.kan proves dvd_zero/dvd_add/dvd_mul_l/dvd_lin/dvd_sub; and
-- std/divmod.kan proves dvd_mod_fwd/dvd_mod_bwd — i.e. d|b ∧ d|(a mod b) ⟺ d|a
-- ∧ d|b, the fact that makes gcd(a,b) = gcd(b, a mod b) preserve the divisor set.
--
-- DONE (milestone 2 COMPLETE, stages 5–6): the verified gcd tower. std/gcd.kan:
--  • gcdI — fuel-Euclid gcd (gcd(a,0)=a; gcd(a,b)=gcd(b, a mod b)); it computes.
--  • gcd_dvd      : Dvd (gcdI a b) a  ×  Dvd (gcdI a b) b   (gcd divides both).
--  • gcd_greatest : Dvd c a → Dvd c b → Dvd c (gcdI a b)    (maximality).
--  • reduce_coprime : dividing a,b by their gcd yields a COPRIME pair (lowest
--    terms) — via mul_cancel_r. This is the last load-bearing lemma a
--    type-ENFORCED `Rational` (den ≠ 0 and coprimality as PROOF fields) needs.
-- No axioms anywhere in the tower (stages 3–6).
--
-- DONE (milestone 2 SUMMIT): the type-ENFORCED rational is assembled.
-- std/rational_reduced.kan defines
--   Reduced = (num:Int) * (den:Nat) * (Lt 0 den) * (Coprime (natAbs num) den)
-- — invariants as PROOF fields — and a smart constructor `reduce : Int -> (d:Nat)
-- -> Lt 0 d -> Reduced` that divides out gcd(|num|,den) and DISCHARGES all four
-- obligations (coprimality via reduce_coprime; den>0 via gcd_pos/mul_pos_factor;
-- sign via a pos/negsuc split that dodges the Bool-elim gap, with natAbs_negOfMag).
-- Divide-by-zero is now a TYPE error, and every value is provably in lowest terms.
--
-- DONE: arithmetic ON `Reduced` (std/rational_reduced.kan) — addR/mulR/subR/negR
-- (total) and recipR/divR (Option: `none` exactly on the zero rational, so there
-- is NO way to divide by zero). Each op computes a raw num/den and re-runs `reduce`,
-- so every RESULT is again provably lowest-terms with a positive denominator
-- (product denominator positive by mul_pos). This is now genuinely "provably exact
-- rational arithmetic, divide-by-zero impossible by construction, lowest terms
-- proven."
--
-- DONE (ring axioms, additive group): (ℤ, +) is a COMMUTATIVE GROUP, proven, no
-- axioms — addI_comm + addI_zero (above) + addI_assoc + addI_negI (i + −i = 0).
-- The additive theory uses the diff-homomorphism toolkit (diff_n_n, diff_m_0,
-- diff_cancel_l, add_diff_pos, add_diff_negsuc), all by double induction with NO
-- sign analysis (diff (suc j)(suc k) ≡ diff j k makes each suc/suc case the IH).
-- addI_negI is exactly the additive-inverse law the constructive-real proof tier
-- (ADR-017) was blocked on.
--
-- DONE (ring axioms, multiplicative): (ℤ, ·) is a COMMUTATIVE MONOID WITH
-- ABSORBING ZERO — mulI_comm (above) + mulI_one_l/r + mulI_zero_l/r + mulI_assoc.
-- mulI_assoc is an 8-sign-case helper tree (mAssocPP/PN/NP/NN), splitting a
-- pos-magnitude into zero/suc exactly where a mixed-sign product's magnitude is
-- stuck (16 leaves). Integer splits make isNeg/xor literal and magnitude splits
-- make intOfSignMag true a constructor, so the Bool-elim gap is never faced.
-- Combined with (ℤ,+) a commutative group, this is EVERYTHING of a commutative
-- ring EXCEPT distributivity.
--
-- DONE (DISTRIBUTIVITY — (ℤ,+,·) IS A COMMUTATIVE RING, proven, no axioms):
-- mulI_distrib_l (a·(b+c) = a·b + a·c) and mulI_distrib_r (free, via mulI_comm).
-- Route B: the load-bearing bridge diff_add (addI is diff-additive:
-- (a−b)+(c−d) = (a+c)−(b+d)) + the mul-over-diff workhorses (mul_diff_pos/negsuc)
-- + mul_add_distrib_l on Nat. The 8 leaves convert both sides to `diff` and glue;
-- same-sign (b,c) use Nat distributivity, mixed-sign use the workhorses. The
-- Bool-elim gap is never faced (integer/magnitude splits keep everything literal),
-- and diff 0 Y ≡ intOfSignMag true Y definitionally links the negative products.
--
-- So the FULL commutative-ring axioms on ℤ hold: (ℤ,+) a commutative group,
-- (ℤ,·) a commutative monoid with absorbing zero, and · distributes over +.
--
-- Still to prove (true; in progress; NO axioms will paper over them):
--  • the FIELD LAWS of ℚ (addR/mulR assoc, comm, distrib on Reduced — up to the
--    cross-multiplication setoid EqR). The MATH is unblocked (they follow from the
--    ring axioms above), and the approach is proven correct — but it is now
--    CHECK-TIME-BLOCKED on ADR-016: the keystone `reduce_crossmul` needs to reduce
--    `numR/denR (reduce n d p)`, whose conversion re-traverses the `gcd_dvd` neutral
--    (its negsuc case exceeds 100s to type-check; the pos case is ~7s). The correct
--    development is parked in docs/rational_laws_draft.kan (EqR/refl/sym/cross_nat_abs
--    check instantly; reduce_crossmul's pos case checks). Bridge lemma
--    mulI_intSMtrue_pos (here) and mul_swap3 (nat.kan) landed for it.
--  • the ADR-016 evaluator/conversion perf fix — now the CRITICAL PATH for BOTH the
--    ℚ field laws and the proof-carrying constructive-real tier (ADR-017).
